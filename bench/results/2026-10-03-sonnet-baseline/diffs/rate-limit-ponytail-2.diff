-from fastapi import FastAPI
+import time
+from collections import defaultdict
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+RATE_LIMIT = 5
+WINDOW_SECONDS = 10
+# ponytail: per-process in-memory dict, resets on restart and isn't shared
+# across workers; swap for a Redis counter if you scale past one process.
+_hits = defaultdict(list)
+
+
+def rate_limit(request: Request) -> None:
+    now = time.monotonic()
+    ip = request.client.host
+    recent = [t for t in _hits[ip] if now - t < WINDOW_SECONDS]
+    if len(recent) >= RATE_LIMIT:
+        raise HTTPException(status_code=429, detail="Too many requests")
+    recent.append(now)
+    _hits[ip] = recent
+
 
 class Message(BaseModel):
     text: str
 
 
 @app.post("/messages")
-def create_message(message: Message):
+def create_message(message: Message, _: None = Depends(rate_limit)):
     return {"ok": True, "length": len(message.text)}
