diff --git a/debounce.js b/debounce.js
new file mode 100644
index 0000000..f69e53c
--- /dev/null
+++ b/debounce.js
@@ -0,0 +1,12 @@
+function debounce(fn, delay) {
+  let timeoutId;
+
+  return function debounced(...args) {
+    clearTimeout(timeoutId);
+    timeoutId = setTimeout(() => {
+      fn.apply(this, args);
+    }, delay);
+  };
+}
+
+module.exports = debounce;
