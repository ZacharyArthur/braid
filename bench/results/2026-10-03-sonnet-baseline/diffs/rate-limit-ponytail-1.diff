--- a/main.py
+++ b/main.py
@@ -1,13 +1,32 @@
-from fastapi import FastAPI
+import time
+from collections import defaultdict
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+RATE_LIMIT = 5  # requests
+RATE_WINDOW = 60  # seconds
+# ponytail: in-memory per-process dict, resets on restart and doesn't share
+# state across workers. Swap for a Redis-backed limiter if you scale past one process.
+_hits = defaultdict(list)
+
+
+def rate_limit(request: Request):
+    ip = request.client.host
+    now = time.monotonic()
+    recent = [t for t in _hits[ip] if now - t < RATE_WINDOW]
+    if len(recent) >= RATE_LIMIT:
+        raise HTTPException(status_code=429, detail="Too many requests")
+    recent.append(now)
+    _hits[ip] = recent
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(rate_limit)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
diff --git a/test_rate_limit.py b/test_rate_limit.py
new file mode 100644
index 0000000..0f44477
--- /dev/null
+++ b/test_rate_limit.py
@@ -0,0 +1,20 @@
+from fastapi.testclient import TestClient
+
+from main import app
+
+client = TestClient(app)
+
+
+def test_rate_limit_trips_then_recovers():
+    for _ in range(5):
+        assert client.post("/messages", json={"text": "hi"}).status_code == 200
+    assert client.post("/messages", json={"text": "hi"}).status_code == 429
+
+    import main
+    main._hits.clear()  # simulate window elapsing
+    assert client.post("/messages", json={"text": "hi"}).status_code == 200
+
+
+if __name__ == "__main__":
+    test_rate_limit_trips_then_recovers()
+    print("ok")
