-from fastapi import FastAPI
+from collections import deque
+from math import ceil
+from threading import Lock
+from time import monotonic
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+RATE_LIMIT = 10
+RATE_WINDOW = 60
+# braid(yagni): per-process counters; use a shared store for multiple workers.
+requests_by_ip = {}
+rate_lock = Lock()
+
+
+def limit_requests(request: Request):
+    ip = request.client.host if request.client else "unknown"
+    with rate_lock:
+        now = monotonic()
+        for key, timestamps in list(requests_by_ip.items()):
+            while timestamps and timestamps[0] <= now - RATE_WINDOW:
+                timestamps.popleft()
+            if not timestamps:
+                del requests_by_ip[key]
+
+        timestamps = requests_by_ip.setdefault(ip, deque())
+        if len(timestamps) >= RATE_LIMIT:
+            retry_after = ceil(timestamps[0] + RATE_WINDOW - now)
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests",
+                headers={"Retry-After": str(retry_after)},
+            )
+        timestamps.append(now)
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(limit_requests)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
