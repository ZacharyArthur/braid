 @app.post("/messages")
-def create_message(message: Message):
+def create_message(message: Message, request: Request):
+    # Use the connected peer; forwarded headers are only safe behind a trusted proxy.
+    client_ip = request.client.host if request.client else "unknown"
+    with rate_lock:
+        now = monotonic()
+        for ip, timestamps in list(requests_by_ip.items()):
+            while timestamps and timestamps[0] <= now - RATE_WINDOW:
+                timestamps.popleft()
+            if not timestamps:
+                del requests_by_ip[ip]
+        timestamps = requests_by_ip.setdefault(client_ip, deque())
+        if len(timestamps) >= RATE_LIMIT:
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests",
+                headers={"Retry-After": str(ceil(timestamps[0] + RATE_WINDOW - now))},
+            )
+        timestamps.append(now)
     return {"ok": True, "length": len(message.text)}
