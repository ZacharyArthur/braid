@@ -0,0 +1,26 @@
+import { useEffect, useState } from 'react';
+
+function normalizeSeconds(seconds) {
+  return Number.isFinite(seconds) ? Math.max(0, Math.floor(seconds)) : 0;
+}
+
+export default function Countdown({ seconds = 0 }) {
+  const duration = normalizeSeconds(seconds);
+  const [remaining, setRemaining] = useState(duration);
+
+  useEffect(() => {
+    setRemaining(duration);
+    if (duration === 0) return;
+
+    const endTime = Date.now() + duration * 1000;
+    const intervalId = setInterval(() => {
+      const next = Math.max(0, Math.ceil((endTime - Date.now()) / 1000));
+      setRemaining(next);
+      if (next === 0) clearInterval(intervalId);
+    }, 1000);
+
+    return () => clearInterval(intervalId);
+  }, [duration]);
+
+  return <span role="timer">{remaining} seconds remaining</span>;
+}
