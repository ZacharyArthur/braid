@@ -0,0 +1,15 @@
+const assert = require('node:assert/strict');
+const { salesReport, refundReport, creditReport } = require('./reports');
+
+for (const [title, report] of [
+  ['Sales', salesReport],
+  ['Refunds', refundReport],
+  ['Credits', creditReport],
+]) {
+  assert.equal(report([]), `${title}\n${'-'.repeat(title.length)}\nTotal             0.00`);
+  assert.equal(
+    report([{ date: '2026-10-01', amount: 12.5 }, { date: '2026-10-02', amount: -2 }]),
+    `${title}\n${'-'.repeat(title.length)}\n2026-10-01       12.50\n2026-10-02       -2.00\nTotal            10.50`,
+  );
+}
+console.log('All three reports passed formatting and total checks.');
