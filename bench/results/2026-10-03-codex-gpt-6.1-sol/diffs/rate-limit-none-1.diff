-from fastapi import FastAPI
+from collections import deque
+from math import ceil
+from threading import Lock
+from time import monotonic
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+# Per-process, sliding-window limit. Use a shared store for multiple workers.
+MESSAGE_RATE_LIMIT = 10
+MESSAGE_RATE_WINDOW_SECONDS = 60
+_message_requests: dict[str, deque[float]] = {}
+_rate_limit_lock = Lock()
+
+
+def limit_message_requests(request: Request) -> None:
+    # Use the peer address; do not trust user-supplied forwarding headers here.
+    client_ip = request.client.host if request.client else "unknown"
+    with _rate_limit_lock:
+        now = monotonic()
+        cutoff = now - MESSAGE_RATE_WINDOW_SECONDS
+        # Remove expired entries, including clients that have stopped sending.
+        for key in list(_message_requests):
+            timestamps = _message_requests[key]
+            while timestamps and timestamps[0] <= cutoff:
+                timestamps.popleft()
+            if not timestamps:
+                del _message_requests[key]
+
+        timestamps = _message_requests.setdefault(client_ip, deque())
+        if len(timestamps) >= MESSAGE_RATE_LIMIT:
+            retry_after = max(
+                1, ceil(timestamps[0] + MESSAGE_RATE_WINDOW_SECONDS - now)
+            )
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests. Please try again later.",
+                headers={"Retry-After": str(retry_after)},
+            )
+        timestamps.append(now)
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(limit_message_requests)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
