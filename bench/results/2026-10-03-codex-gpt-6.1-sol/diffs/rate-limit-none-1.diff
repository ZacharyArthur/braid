+import unittest
+from unittest.mock import patch
+
+from fastapi.testclient import TestClient
+
+import main
+
+
+class MessageRateLimitTests(unittest.TestCase):
+    def setUp(self):
+        main._message_requests.clear()
+        self.client = TestClient(main.app)
+        self.clock = patch("main.monotonic", return_value=100.0)
+        self.now = self.clock.start()
+        self.addCleanup(self.clock.stop)
+
+    def send(self, client=None, **kwargs):
+        return (client or self.client).post(
+            "/messages", json={"text": "hello"}, **kwargs
+        )
+
+    def test_limit_and_window_expiry(self):
+        for _ in range(main.MESSAGE_RATE_LIMIT):
+            response = self.send()
+            self.assertEqual(response.status_code, 200)
+            self.assertEqual(response.json(), {"ok": True, "length": 5})
+        self.now.return_value = 100.1
+        response = self.send()
+        self.assertEqual(response.status_code, 429)
+        self.assertEqual(response.headers["Retry-After"], "60")
+        self.now.return_value = 160.0
+        self.assertEqual(self.send().status_code, 200)
+
+    def test_clients_have_separate_limits_and_cannot_spoof_headers(self):
+        for _ in range(main.MESSAGE_RATE_LIMIT):
+            self.send()
+        self.assertEqual(
+            self.send(headers={"X-Forwarded-For": "different-client"}).status_code,
+            429,
+        )
+        other = TestClient(main.app, client=("192.0.2.2", 12345))
+        self.assertEqual(self.send(other).status_code, 200)
+
+    def test_inactive_clients_are_removed(self):
+        self.send()
+        self.now.return_value = 160.0
+        other = TestClient(main.app, client=("192.0.2.2", 12345))
+        self.send(other)
+        self.assertNotIn("testclient", main._message_requests)
+
+
+if __name__ == "__main__":
+    unittest.main()
