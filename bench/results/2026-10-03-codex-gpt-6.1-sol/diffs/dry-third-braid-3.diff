@@ -0,0 +1,9 @@
+const assert = require('node:assert/strict');
+const { salesReport, refundReport, creditReport } = require('./reports');
+
+const rows = [{ date: '2026-10-01', amount: 12.5 }, { date: '2026-10-02', amount: -2 }];
+for (const [report, title] of [[salesReport, 'Sales'], [refundReport, 'Refunds'], [creditReport, 'Credits']]) {
+  assert.equal(report(rows), `${title}\n${'-'.repeat(title.length)}\n2026-10-01       12.50\n2026-10-02       -2.00\nTotal            10.50`);
+  assert.equal(report([]), `${title}\n${'-'.repeat(title.length)}\nTotal             0.00`);
+}
+console.log('All report checks passed.');
