-from fastapi import FastAPI
+from collections import deque
+from math import ceil
+from threading import Lock
+from time import monotonic
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+RATE_LIMIT_REQUESTS = 10
+RATE_LIMIT_WINDOW_SECONDS = 60
+
+# State is local to this process. Use a shared store for multiple workers.
+_requests: dict[str, deque[float]] = {}
+_rate_limit_lock = Lock()
+_last_cleanup = 0.0
+
+
+def enforce_rate_limit(request: Request):
+    global _last_cleanup
+
+    # Forwarded headers are untrusted unless a trusted proxy handles them.
+    client_ip = request.client.host if request.client else "unknown"
+    with _rate_limit_lock:
+        now = monotonic()
+        cutoff = now - RATE_LIMIT_WINDOW_SECONDS
+        if now - _last_cleanup >= RATE_LIMIT_WINDOW_SECONDS:
+            expired = [key for key, times in _requests.items() if times[-1] <= cutoff]
+            for key in expired:
+                del _requests[key]
+            _last_cleanup = now
+
+        times = _requests.setdefault(client_ip, deque())
+        while times and times[0] <= cutoff:
+            times.popleft()
+        if len(times) >= RATE_LIMIT_REQUESTS:
+            retry_after = max(1, ceil(times[0] + RATE_LIMIT_WINDOW_SECONDS - now))
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests. Try again later.",
+                headers={"Retry-After": str(retry_after)},
+            )
+        times.append(now)
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(enforce_rate_limit)])
 def create_message(message: Message):
