new file mode 100644
index 0000000..99b0b01
--- /dev/null
+++ b/debounce.js
@@ -0,0 +1,10 @@
+function debounce(fn, delay) {
+  let timer;
+
+  return function (...args) {
+    clearTimeout(timer);
+    timer = setTimeout(() => fn.apply(this, args), delay);
+  };
+}
+
+module.exports = debounce;
diff --git a/debounce.test.js b/debounce.test.js
new file mode 100644
index 0000000..583a270
--- /dev/null
+++ b/debounce.test.js
@@ -0,0 +1,24 @@
+const assert = require('node:assert/strict');
+const debounce = require('./debounce');
+
+async function test() {
+  const calls = [];
+  const context = { run: debounce(function (...args) {
+    calls.push({ context: this, args });
+  }, 20) };
+
+  context.run('first');
+  context.run('last', 2);
+  assert.equal(calls.length, 0);
+  await new Promise(resolve => setTimeout(resolve, 50));
+  assert.deepEqual(calls, [{ context, args: ['last', 2] }]);
+
+  context.run('again');
+  await new Promise(resolve => setTimeout(resolve, 50));
+  assert.equal(calls.length, 2);
+}
+
+test().catch(error => {
+  console.error(error);
+  process.exitCode = 1;
+});
