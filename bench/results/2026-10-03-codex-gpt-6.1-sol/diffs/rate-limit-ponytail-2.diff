-from fastapi import FastAPI
+from math import ceil
+from threading import Lock
+from time import monotonic
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
+RATE_LIMIT = 10
+RATE_WINDOW = 60
+_lock = Lock()
+_window_start = monotonic()
+_counts: dict[str, int] = {}
+
+
+def rate_limit(request: Request):
+    global _window_start
+    # ponytail: per-process fixed window; use a shared store for multiple workers.
+    client = request.client.host if request.client else "unknown"
+    with _lock:
+        now = monotonic()
+        if now - _window_start >= RATE_WINDOW:
+            _counts.clear()
+            _window_start = now
+        if _counts.get(client, 0) >= RATE_LIMIT:
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests",
+                headers={"Retry-After": str(ceil(RATE_WINDOW - (now - _window_start)))},
+            )
+        _counts[client] = _counts.get(client, 0) + 1
 
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(rate_limit)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
