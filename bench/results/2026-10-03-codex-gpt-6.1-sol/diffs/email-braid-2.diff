+import re
+
+
+def is_valid_email(address: str) -> bool:
+    """Validate common ASCII email syntax; does not check deliverability."""
+    # braid(yagni): no quoted or international addresses; add if required.
+    if not isinstance(address, str) or len(address) > 254:
+        return False
+    local, separator, domain = address.rpartition("@")
+    if not separator or not 1 <= len(local) <= 64:
+        return False
+    if not re.fullmatch(r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*", local):
+        return False
+    label = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
+    return re.fullmatch(rf"{label}(?:\.{label})+", domain) is not None
+
+
+if __name__ == "__main__":
+    for address in ("user@example.com", "first.last+tag@sub.example.org", "a@b.co"):
+        assert is_valid_email(address), address
+    for address in (
+        None, "", "user", "user@@example.com", " user@example.com",
+        "user@example.com\n", ".user@example.com", "user..name@example.com",
+        "user@localhost", "user@-example.com", "user@example-.com",
+        "user@" + "a" * 64 + ".com", "a" * 65 + "@example.com",
+        "a@" + ".".join(["b" * 63] * 4),
+    ):
+        assert not is_valid_email(address), address
+    print("Email validation checks passed.")
