-from fastapi import FastAPI
+from collections import deque
+from math import ceil
+from threading import Lock
+from time import monotonic
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
+RATE_LIMIT = 10
+RATE_WINDOW = 60
+_requests: dict[str, deque[float]] = {}
+_rate_lock = Lock()
+
+
+# braid(yagni): per-process limits; use a shared store for multiple workers.
+def limit_messages(request: Request):
+    client = request.client.host if request.client else "unknown"
+    with _rate_lock:
+        now = monotonic()
+        for key, timestamps in list(_requests.items()):
+            while timestamps and timestamps[0] <= now - RATE_WINDOW:
+                timestamps.popleft()
+            if not timestamps:
+                del _requests[key]
+
+        timestamps = _requests.setdefault(client, deque())
+        if len(timestamps) >= RATE_LIMIT:
+            retry_after = ceil(timestamps[0] + RATE_WINDOW - now)
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests",
+                headers={"Retry-After": str(retry_after)},
+            )
+        timestamps.append(now)
 
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(limit_messages)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
