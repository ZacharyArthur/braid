+import { useEffect, useState } from "react";
+
+/** Counts down in whole seconds and restarts when `seconds` changes. */
+export default function Countdown({ seconds = 0 }) {
+  const duration = Number.isFinite(seconds)
+    ? Math.max(0, Math.floor(seconds))
+    : 0;
+  const [remaining, setRemaining] = useState(duration);
+
+  useEffect(() => {
+    setRemaining(duration);
+    if (duration === 0) return;
+
+    // Use elapsed time so delayed interval callbacks do not cause drift.
+    const deadline = Date.now() + duration * 1000;
+    const intervalId = setInterval(() => {
+      const next = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
+      setRemaining(next);
+      if (next === 0) clearInterval(intervalId);
+    }, 1000);
+
+    return () => clearInterval(intervalId);
+  }, [seconds, duration]);
+
+  return <span role="timer">{remaining}</span>;
+}
