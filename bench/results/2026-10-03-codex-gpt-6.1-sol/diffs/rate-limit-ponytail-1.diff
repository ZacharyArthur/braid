-from fastapi import FastAPI
+from collections import deque
+from math import ceil
+from threading import Lock
+from time import monotonic
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+RATE_LIMIT = 10
+RATE_WINDOW_SECONDS = 60
+_requests: dict[str, deque[float]] = {}
+_lock = Lock()
+
+
+def limit_requests(request: Request):
+    # Use the peer IP; forwarded headers require a trusted proxy configuration.
+    client = request.client.host if request.client else "unknown"
+    # ponytail: process-local lock and O(n) cleanup; use shared storage for multiple workers or high traffic.
+    with _lock:
+        now = monotonic()
+        for host in list(_requests):
+            timestamps = _requests[host]
+            while timestamps and timestamps[0] <= now - RATE_WINDOW_SECONDS:
+                timestamps.popleft()
+            if not timestamps:
+                del _requests[host]
+        timestamps = _requests.setdefault(client, deque())
+        if len(timestamps) >= RATE_LIMIT:
+            retry_after = ceil(timestamps[0] + RATE_WINDOW_SECONDS - now)
+            raise HTTPException(
+                status_code=429,
+                detail="Rate limit exceeded",
+                headers={"Retry-After": str(retry_after)},
+            )
+        timestamps.append(now)
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(limit_requests)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
