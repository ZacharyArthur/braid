@@ -0,0 +1,33 @@
+from unittest.mock import patch
+
+from fastapi.testclient import TestClient
+
+import main
+
+
+def test_rate_limit():
+    main._requests.clear()
+    with patch("main.monotonic", return_value=100) as clock:
+        with TestClient(main.app) as client:
+            for _ in range(main.RATE_LIMIT):
+                response = client.post("/messages", json={"text": "hello"})
+                assert response.status_code == 200
+                assert response.json() == {"ok": True, "length": 5}
+            response = client.post("/messages", json={"text": "hello"})
+            assert response.status_code == 429
+            assert response.headers["Retry-After"] == "60"
+            with TestClient(main.app, client=("another-client", 50000)) as other:
+                assert other.post("/messages", json={"text": "hi"}).status_code == 200
+            clock.return_value = 159.5
+            response = client.post("/messages", json={"text": "hello"})
+            assert response.status_code == 429
+            assert response.headers["Retry-After"] == "1"
+            clock.return_value = 160
+            assert client.post("/messages", json={"text": "hello"}).status_code == 200
+            assert "another-client" not in main._requests
+    main._requests.clear()
+
+
+if __name__ == "__main__":
+    test_rate_limit()
+    print("Rate limit check passed")
