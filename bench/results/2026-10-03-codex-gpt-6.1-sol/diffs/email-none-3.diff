@@ -0,0 +1,29 @@
+"""Validation for common Internet email address syntax."""
+
+import re
+
+
+_LOCAL_PART = re.compile(r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*")
+_DOMAIN_LABEL = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?")
+
+
+def is_valid_email(address: str) -> bool:
+    """Return whether address has common ASCII email syntax.
+
+    Supports unquoted local parts and dotted DNS domains, including punycode.
+    Rejects whitespace, quoted local parts, domain literals, and Unicode.
+    This checks syntax only; it does not verify that a mailbox exists.
+    """
+    if not isinstance(address, str) or not address.isascii():
+        return False
+    if len(address) > 254 or address.count("@") != 1:
+        return False
+
+    local, domain = address.split("@")
+    if len(local) > 64 or _LOCAL_PART.fullmatch(local) is None:
+        return False
+
+    labels = domain.split(".")
+    return len(labels) >= 2 and all(
+        _DOMAIN_LABEL.fullmatch(label) is not None for label in labels
+    )
