@@ -0,0 +1,12 @@
+from contextlib import redirect_stdout
+from io import StringIO
+from pathlib import Path
+import runpy
+from unittest.mock import mock_open, patch
+
+
+script = Path(__file__).with_name("sum_sales.py").resolve()
+output = StringIO()
+with patch("builtins.open", mock_open(read_data="amount\n0.10\n0.20\n")), redirect_stdout(output):
+    runpy.run_path(str(script))
+assert output.getvalue().strip() == "0.30", output.getvalue()
