+// Run with: node Countdown.test.cjs
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+
+let now = 0;
+let remaining;
+let effect;
+let tick;
+let cleared = false;
+const context = {
+  useState: (initial) => {
+    remaining = initial;
+    return [remaining, (value) => { remaining = value; }];
+  },
+  useEffect: (callback) => { effect = callback; },
+  Date: { now: () => now },
+  setInterval: (callback) => { tick = callback; cleared = false; return 1; },
+  clearInterval: () => { cleared = true; },
+};
+const source = fs.readFileSync(`${__dirname}/Countdown.jsx`, 'utf8')
+  .replace(/^import .*;\r?\n/, '')
+  .replace('export default function', 'function')
+  .replace(/return <span[^\n]+/, 'return remaining;');
+vm.createContext(context);
+vm.runInContext(source, context);
+
+assert.equal(context.Countdown({ seconds: 3 }), 3);
+const cleanup = effect();
+now = 1000;
+tick();
+assert.equal(remaining, 2);
+now = 5000; // A delayed tick still reaches zero.
+tick();
+assert.equal(remaining, 0);
+assert.equal(cleared, true);
+cleanup();
+
+context.Countdown({ seconds: 2 });
+const resetCleanup = effect();
+assert.equal(remaining, 2);
+resetCleanup();
+assert.equal(cleared, true);
+for (const seconds of [0, -1, NaN, Infinity, undefined]) {
+  assert.equal(context.Countdown({ seconds }), 0);
+  assert.equal(effect(), undefined);
+}
+console.log('Countdown checks passed');
