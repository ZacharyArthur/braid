index 0000000..3fdb94f
--- /dev/null
+++ b/validate.py
@@ -0,0 +1,26 @@
+import re
+
+# braid(yagni): pragmatic syntax check, not full RFC 5322; confirm real addresses by sending mail
+_EMAIL = re.compile(
+    r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*"  # local part
+    r"@"
+    r"([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}"  # domain with TLD
+)
+
+
+def is_valid_email(address) -> bool:
+    return (
+        isinstance(address, str)
+        and len(address) <= 254
+        and len(address.partition("@")[0]) <= 64
+        and _EMAIL.fullmatch(address) is not None
+    )
+
+
+if __name__ == "__main__":
+    good = ["a@b.co", "first.last+tag@example.com", "x_y@sub.domain.org"]
+    bad = ["", "a@b", "a@@b.com", ".a@b.com", "a..b@c.com", "a@-b.com",
+           "a b@c.com", "a@b.c", "@b.com", "a@b.com\n", None, 5]
+    assert all(is_valid_email(a) for a in good)
+    assert not any(is_valid_email(a) for a in bad)
+    print("ok")
