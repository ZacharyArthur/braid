+++ b/validate.py
@@ -0,0 +1,24 @@
+import re
+
+# braid(yagni): practical subset of RFC 5322 (no quoted locals, IP literals, or unicode); use email-validator if needed
+_EMAIL = re.compile(
+    r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*"  # local: dot-separated atoms
+    r"@"
+    r"([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}"  # domain: labels + alpha TLD
+)
+
+
+def is_valid_email(address) -> bool:
+    if not isinstance(address, str) or len(address) > 254:
+        return False
+    return _EMAIL.fullmatch(address) is not None and len(address.split("@")[0]) <= 64
+
+
+if __name__ == "__main__":
+    good = ["a@b.co", "john.doe+tag@example.com", "x_y@sub.example.org", "a@xn--bcher-kva.example"]
+    bad = ["", "plain", "@x.com", "a@", "a@b", "a..b@x.com", ".a@x.com", "a.@x.com",
+           "a@-x.com", "a@x-.com", "a b@x.com", "a@x..com", "a@x.c", "a@@x.com",
+           "a@x.com\n", "a" * 65 + "@x.com", None, 5]
+    assert all(is_valid_email(a) for a in good), [a for a in good if not is_valid_email(a)]
+    assert not any(is_valid_email(a) for a in bad), [a for a in bad if is_valid_email(a)]
+    print("ok")
