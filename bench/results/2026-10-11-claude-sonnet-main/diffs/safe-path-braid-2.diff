+import os
+
+
 def safe_upload_path(base_dir, filename):
-    """Join an untrusted filename onto base_dir and return the path."""
-    raise NotImplementedError
+    """Join an untrusted filename onto base_dir and return the path.
+
+    Raises ValueError if the result would fall outside base_dir.
+    """
+    base = os.path.realpath(base_dir)
+    path = os.path.realpath(os.path.join(base, filename))
+    if "\0" in filename or path == base or os.path.commonpath([base, path]) != base:
+        raise ValueError(f"unsafe upload filename: {filename!r}")
+    return path
+
+
+if __name__ == "__main__":
+    import tempfile
+
+    d = tempfile.mkdtemp()
+    assert safe_upload_path(d, "a.txt") == os.path.join(os.path.realpath(d), "a.txt")
+    assert safe_upload_path(d, "sub/a.txt").endswith("a.txt")
+    for bad in ["../x", "..\\x", "/etc/passwd", "C:\\Windows\\x", "a/../../x", "", ".", "a\0b"]:
+        try:
+            safe_upload_path(d, bad)
+        except ValueError:
+            continue
+        raise AssertionError(f"accepted {bad!r}")
+    print("ok")
