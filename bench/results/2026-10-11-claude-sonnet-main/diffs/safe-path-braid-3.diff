+import os
+
+
 def safe_upload_path(base_dir, filename):
-    """Join an untrusted filename onto base_dir and return the path."""
-    raise NotImplementedError
+    """Join an untrusted filename onto base_dir and return the path.
+
+    Raises ValueError if the result would fall outside base_dir
+    (traversal, absolute path, drive letter, symlink escape).
+    """
+    base = os.path.realpath(base_dir)
+    path = os.path.realpath(os.path.join(base, filename))
+    if "\0" in filename or path == base or os.path.commonpath([base, path]) != base:
+        raise ValueError(f"unsafe upload path: {filename!r}")
+    return path
+
+
+if __name__ == "__main__":
+    b = os.path.realpath("uploads_test_dir")
+    assert safe_upload_path(b, "a.txt") == os.path.join(b, "a.txt")
+    assert safe_upload_path(b, "sub/a.txt") == os.path.join(b, "sub", "a.txt")
+    for bad in ["../x", "a/../../x", "/etc/passwd", "C:\\Windows\\x", "..\\x", ".", "", "\0"]:
+        try:
+            safe_upload_path(b, bad)
+        except ValueError:
+            continue
+        raise AssertionError(f"accepted {bad!r}")
+    print("ok")
