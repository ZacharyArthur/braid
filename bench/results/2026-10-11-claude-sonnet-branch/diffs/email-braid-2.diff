+import re
+
+# shortcut(kiss): pragmatic ASCII check, no quoted locals, IP literals or IDN; upgrade to a library if those matter.
+_EMAIL = re.compile(
+    r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*"
+    r"@([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}"
+)
+
+
+def is_valid_email(address) -> bool:
+    return isinstance(address, str) and len(address) <= 254 and _EMAIL.fullmatch(address) is not None
+
+
+if __name__ == "__main__":
+    for ok in ["a@b.co", "john.doe+tag@example.com", "x_y@sub.example.org"]:
+        assert is_valid_email(ok), ok
+    for bad in ["", "a@b", "a@@b.co", ".a@b.co", "a..b@c.co", "a@-b.co", "a b@c.co", "a@b.c", None, "a@b.co\n"]:
+        assert not is_valid_email(bad), bad
+    print("ok")
