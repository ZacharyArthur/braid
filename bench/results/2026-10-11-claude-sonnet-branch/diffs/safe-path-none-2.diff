+import os
+
+
 def safe_upload_path(base_dir, filename):
-    """Join an untrusted filename onto base_dir and return the path."""
-    raise NotImplementedError
+    """Join an untrusted filename onto base_dir and return the path.
+
+    Raises ValueError if the filename is empty, contains a NUL byte, is
+    absolute, or would resolve to a location outside base_dir.
+    """
+    if not filename or "\x00" in filename:
+        raise ValueError("invalid filename")
+
+    # Treat both separators as separators regardless of platform, and reject
+    # absolute paths and drive-qualified names outright.
+    normalized = filename.replace("\\", "/")
+    if normalized.startswith("/") or os.path.isabs(filename) or os.path.splitdrive(filename)[0]:
+        raise ValueError("absolute paths are not allowed")
+
+    base = os.path.realpath(base_dir)
+    path = os.path.realpath(os.path.join(base, *normalized.split("/")))
+
+    # Resolved path must be strictly inside base (realpath also follows symlinks).
+    if os.path.commonpath([base, path]) != base or path == base:
+        raise ValueError("path escapes upload directory")
+
+    return path
