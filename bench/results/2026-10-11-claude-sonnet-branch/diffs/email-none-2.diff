@@ -0,0 +1,30 @@
+import re
+
+_LOCAL_RE = re.compile(r"^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*$")
+_LABEL_RE = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$")
+
+
+def is_valid_email(address) -> bool:
+    """Return True if `address` looks like a valid email address.
+
+    Checks the common practical subset of RFC 5321/5322: a dot-atom local
+    part (max 64 chars) and a domain of at least two DNS labels with an
+    alphabetic TLD (max 255 chars total, 254 overall).
+    """
+    if not isinstance(address, str) or len(address) > 254:
+        return False
+
+    local, sep, domain = address.rpartition("@")
+    if not sep or not local or not domain:
+        return False
+    if len(local) > 64 or not _LOCAL_RE.match(local):
+        return False
+
+    if len(domain) > 253:
+        return False
+    labels = domain.split(".")
+    if len(labels) < 2:
+        return False
+    if not all(_LABEL_RE.match(label) for label in labels):
+        return False
+    return labels[-1].isalpha() and len(labels[-1]) >= 2
