-from fastapi import FastAPI
+import time
+from collections import defaultdict, deque
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+LIMIT, WINDOW = 5, 60  # requests per client IP per WINDOW seconds
+_hits = defaultdict(deque)
+
+
+# shortcut: in-memory per-process, keyed by IP; use Redis once running multiple workers or behind a proxy
+def rate_limit(request: Request):
+    now = time.monotonic()
+    hits = _hits[request.client.host]
+    while hits and hits[0] <= now - WINDOW:
+        hits.popleft()
+    if len(hits) >= LIMIT:
+        raise HTTPException(429, "Too many requests", headers={"Retry-After": str(WINDOW)})
+    hits.append(now)
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(rate_limit)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
