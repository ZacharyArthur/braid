@@ -0,0 +1,18 @@
+import re
+
+# shortcut: practical subset of RFC 5322 (no quoted locals, IP-literal domains, or unicode); use email-validator if you need full compliance
+_EMAIL = re.compile(
+    r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*"
+    r"@([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}"
+)
+
+
+def is_valid_email(address) -> bool:
+    return isinstance(address, str) and len(address) <= 254 and bool(_EMAIL.fullmatch(address))
+
+
+if __name__ == "__main__":
+    good = ["a@b.co", "john.doe+tag@example.com", "x_y@sub.example.org"]
+    bad = ["", "a@b", "a@@b.com", ".a@b.com", "a..b@c.com", "a@-b.com", "a b@c.com", "a@b.c", None]
+    assert all(is_valid_email(e) for e in good)
+    assert not any(is_valid_email(e) for e in bad)
