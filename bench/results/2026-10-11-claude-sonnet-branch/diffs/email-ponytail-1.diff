+++ b/validate.py
@@ -0,0 +1,18 @@
+import re
+
+# shortcut: practical subset of RFC 5322 (no quoted locals, IP-literal domains, or unicode); upgrade to email-validator if that matters
+_EMAIL = re.compile(
+    r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*"
+    r"@([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}"
+)
+
+
+def is_valid_email(address) -> bool:
+    return isinstance(address, str) and len(address) <= 254 and len(address.split("@")[0]) <= 64 and _EMAIL.fullmatch(address) is not None
+
+
+if __name__ == "__main__":
+    assert is_valid_email("a.b+c@example.co.uk")
+    for bad in ["", "a@b", "a@@b.com", ".a@b.com", "a..b@b.com", "a@-b.com", "a b@c.com", "a@b.c", None, "a@b.com\n"]:
+        assert not is_valid_email(bad), bad
+    print("ok")
