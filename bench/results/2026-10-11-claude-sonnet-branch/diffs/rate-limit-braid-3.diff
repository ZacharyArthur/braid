@@ -1,13 +1,31 @@
-from fastapi import FastAPI
+import time
+from collections import defaultdict, deque
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+RATE_LIMIT = 5  # requests per client per window
+RATE_WINDOW = 60  # seconds
+# shortcut(kiss): in-memory per-process sliding window, keys never evicted; use Redis if running multiple workers or many clients
+_hits = defaultdict(deque)
+
+
+def rate_limit(request: Request):
+    now = time.monotonic()
+    hits = _hits[request.client.host]
+    while hits and now - hits[0] > RATE_WINDOW:
+        hits.popleft()
+    if len(hits) >= RATE_LIMIT:
+        raise HTTPException(429, "Too many requests", {"Retry-After": str(int(RATE_WINDOW - (now - hits[0])) + 1)})
+    hits.append(now)
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(rate_limit)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
