+import os
+
+
 def safe_upload_path(base_dir, filename):
-    """Join an untrusted filename onto base_dir and return the path."""
-    raise NotImplementedError
+    """Join an untrusted filename onto base_dir and return the path.
+
+    Raises ValueError if the result would fall outside base_dir.
+    """
+    base = os.path.realpath(base_dir)
+    path = os.path.realpath(os.path.join(base, filename))
+    # Absolute filenames, drive letters and ".." all end up outside base here;
+    # realpath also follows symlinks, so a link cannot escape either.
+    if os.path.commonpath([base, path]) != base or path == base:
+        raise ValueError(f"unsafe upload path: {filename!r}")
+    return path
