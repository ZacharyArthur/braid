+import os
+
+
 def safe_upload_path(base_dir, filename):
-    """Join an untrusted filename onto base_dir and return the path."""
-    raise NotImplementedError
+    """Join an untrusted filename onto base_dir and return the path.
+
+    Raises ValueError if the result would fall outside base_dir.
+    """
+    if "\0" in filename:
+        raise ValueError("invalid filename")
+    base = os.path.realpath(base_dir)
+    # realpath also resolves symlinks, so a link inside base_dir can't escape either
+    path = os.path.realpath(os.path.join(base, filename))
+    if os.path.commonpath([base, path]) != base or path == base:
+        raise ValueError("filename escapes base_dir")
+    return path
+
+
+if __name__ == "__main__":
+    import tempfile
+
+    with tempfile.TemporaryDirectory() as d:
+        ok = safe_upload_path(d, "a/b.txt")
+        assert ok.startswith(os.path.realpath(d))
+        for bad in ["../x", "a/../../x", os.path.abspath(os.sep) + "etc", "..\\x", "", ".", "a\0b"]:
+            try:
+                safe_upload_path(d, bad)
+            except ValueError:
+                continue
+            raise AssertionError(f"accepted {bad!r}")
+    print("ok")
