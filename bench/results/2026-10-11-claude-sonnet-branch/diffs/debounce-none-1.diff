+++ b/debounce.js
@@ -0,0 +1,49 @@
+/**
+ * Returns a debounced version of fn that delays invoking it until `delay` ms
+ * have elapsed since the last call. The latest arguments and `this` are used.
+ *
+ * The returned function also exposes:
+ *   - cancel(): discard any pending invocation
+ *   - flush():  invoke immediately if an invocation is pending
+ */
+function debounce(fn, delay) {
+  if (typeof fn !== 'function') {
+    throw new TypeError('debounce: fn must be a function');
+  }
+  delay = Number(delay) || 0;
+
+  let timer = null;
+  let lastArgs;
+  let lastThis;
+
+  function invoke() {
+    const args = lastArgs;
+    const ctx = lastThis;
+    timer = null;
+    lastArgs = lastThis = undefined;
+    return fn.apply(ctx, args);
+  }
+
+  function debounced(...args) {
+    lastArgs = args;
+    lastThis = this;
+    if (timer !== null) clearTimeout(timer);
+    timer = setTimeout(invoke, delay);
+  }
+
+  debounced.cancel = function () {
+    if (timer !== null) clearTimeout(timer);
+    timer = null;
+    lastArgs = lastThis = undefined;
+  };
+
+  debounced.flush = function () {
+    if (timer === null) return undefined;
+    clearTimeout(timer);
+    return invoke();
+  };
+
+  return debounced;
+}
+
+module.exports = debounce;
