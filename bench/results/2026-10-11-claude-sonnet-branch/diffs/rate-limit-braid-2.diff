-from fastapi import FastAPI
+import time
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+LIMIT = 10  # requests per client IP
+WINDOW = 60  # seconds
+_hits: dict[str, list[float]] = {}
+
+
+# shortcut(yagni): in-memory per-process counter; upgrade to Redis/slowapi when running multiple workers.
+def rate_limit(request: Request):
+    now = time.monotonic()
+    ip = request.client.host if request.client else "unknown"
+    hits = [t for t in _hits.get(ip, []) if now - t < WINDOW]
+    if len(hits) >= LIMIT:
+        _hits[ip] = hits
+        raise HTTPException(429, "Too many requests", headers={"Retry-After": str(WINDOW)})
+    hits.append(now)
+    _hits[ip] = hits
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(rate_limit)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
