@@ -0,0 +1,12 @@
+from fastapi.testclient import TestClient
+
+import main
+
+client = TestClient(main.app)
+
+
+def test_rate_limit():
+    main._hits.clear()
+    for _ in range(main.LIMIT):
+        assert client.post("/messages", json={"text": "hi"}).status_code == 200
+    assert client.post("/messages", json={"text": "hi"}).status_code == 429
