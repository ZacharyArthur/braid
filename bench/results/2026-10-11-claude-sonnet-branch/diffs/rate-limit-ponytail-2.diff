-from fastapi import FastAPI
+import time
+from collections import defaultdict, deque
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+LIMIT, WINDOW = 10, 60  # requests per window (seconds), per client IP
+_hits = defaultdict(deque)
+
+
+# shortcut: in-memory and per-process, resets on restart and isn't shared across
+# workers; behind a proxy request.client is the proxy's IP. Upgrade to Redis/proxy headers.
+def rate_limit(request: Request):
+    hits = _hits[request.client.host]
+    now = time.monotonic()
+    while hits and hits[0] <= now - WINDOW:
+        hits.popleft()
+    if len(hits) >= LIMIT:
+        raise HTTPException(429, "Too many requests", {"Retry-After": str(WINDOW)})
+    hits.append(now)
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(rate_limit)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
