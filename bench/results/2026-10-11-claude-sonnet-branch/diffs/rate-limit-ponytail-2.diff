@@ -0,0 +1,11 @@
+from fastapi.testclient import TestClient
+
+import main
+
+client = TestClient(main.app)
+
+
+def test_rate_limit():
+    main._hits.clear()
+    codes = [client.post("/messages", json={"text": "hi"}).status_code for _ in range(main.LIMIT + 1)]
+    assert codes == [200] * main.LIMIT + [429]
