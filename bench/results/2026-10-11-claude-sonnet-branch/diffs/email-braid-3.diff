@@ -0,0 +1,19 @@
+import re
+
+# shortcut(kiss): pragmatic syntax check, not full RFC 5322 (no quoted locals, IP-literal or unicode domains); upgrade if those must be accepted.
+_EMAIL = re.compile(
+    r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*"
+    r"@([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}"
+)
+
+
+def is_valid_email(address) -> bool:
+    return isinstance(address, str) and len(address) <= 254 and _EMAIL.fullmatch(address) is not None and len(address.split("@")[0]) <= 64
+
+
+if __name__ == "__main__":
+    for ok in ["a@b.co", "john.doe+tag@example.com", "x_y@sub.domain.org"]:
+        assert is_valid_email(ok), ok
+    for bad in ["", "a@b", "a@@b.com", ".a@b.com", "a..b@c.com", "a@-b.com", "a b@c.com", "a@b.c", None, "a" * 65 + "@b.com"]:
+        assert not is_valid_email(bad), bad
+    print("ok")
