+import React, { useEffect, useState } from 'react';
+
+export default function Countdown({ seconds }) {
+  const duration = Number.isFinite(seconds) ? Math.max(0, Math.floor(seconds)) : 0;
+  const [remaining, setRemaining] = useState(duration);
+
+  useEffect(() => {
+    setRemaining(duration);
+    if (duration === 0) return;
+
+    let ticksLeft = duration;
+    const interval = setInterval(() => {
+      ticksLeft -= 1;
+      setRemaining(ticksLeft);
+      if (ticksLeft === 0) clearInterval(interval);
+    }, 1000);
+
+    return () => clearInterval(interval);
+  }, [seconds, duration]);
+
+  return <span role="timer">{remaining} seconds remaining</span>;
+}
