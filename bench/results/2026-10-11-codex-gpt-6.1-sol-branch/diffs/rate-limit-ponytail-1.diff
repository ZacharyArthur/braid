+from fastapi import FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+# shortcut: limits are per process and reset on restart; use shared storage for multiple workers.
+_rate_limits: dict[str, tuple[float, int]] = {}
+_rate_limit_lock = Lock()
+
 
 class Message(BaseModel):
     text: str
 
 
 @app.post("/messages")
-def create_message(message: Message):
+def create_message(message: Message, request: Request):
+    client_ip = request.client.host if request.client else "unknown"
+    with _rate_limit_lock:
+        now = monotonic()
+        for ip, (expires, _) in list(_rate_limits.items()):
+            if expires <= now:
+                del _rate_limits[ip]
+        expires, count = _rate_limits.get(client_ip, (now + 60, 0))
+        if count >= 10:
+            raise HTTPException(
+                status_code=429,
+                detail="Rate limit exceeded",
+                headers={"Retry-After": str(ceil(expires - now))},
+            )
+        _rate_limits[client_ip] = (expires, count + 1)
     return {"ok": True, "length": len(message.text)}
