+import shutil
+import unittest
+import uuid
+from pathlib import Path
+
+from uploads import safe_upload_path
+
+
+class SafeUploadPathTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = Path(__file__).parent / f"test-uploads-{uuid.uuid4()}"
+        self.directory.mkdir()
+        self.addCleanup(shutil.rmtree, self.directory)
+
+    def test_relative_uploads(self):
+        for filename in ("photo.jpg", "images/photo.jpg", "images\\photo.jpg"):
+            with self.subTest(filename=filename):
+                expected = self.directory / filename.replace("\\", "/")
+                self.assertEqual(safe_upload_path(self.directory, filename), str(expected.resolve()))
+
+    def test_invalid_paths(self):
+        for filename in (
+            "", ".", "..", "../outside.txt", "..\\outside.txt",
+            "../" + self.directory.name + "-other/file.txt",
+            "/outside.txt", "\\outside.txt", "C:\\outside.txt", "C:outside.txt",
+            "\\\\server\\share\\file.txt", "file\x00.txt", "file.txt:stream", "NUL", None,
+        ):
+            with self.subTest(filename=filename):
+                with self.assertRaises(ValueError):
+                    safe_upload_path(self.directory, filename)
+
+    def test_symlink_escape(self):
+        base = self.directory / "uploads"
+        outside = self.directory / "outside"
+        base.mkdir()
+        outside.mkdir()
+        try:
+            (base / "link").symlink_to(outside, target_is_directory=True)
+        except OSError as error:
+            self.skipTest(f"Symlinks unavailable: {error}")
+        with self.assertRaises(ValueError):
+            safe_upload_path(base, "link/file.txt")
+
+
+if __name__ == "__main__":
+    unittest.main()
