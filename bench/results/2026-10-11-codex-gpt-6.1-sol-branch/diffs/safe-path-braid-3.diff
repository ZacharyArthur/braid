+import ntpath
+from pathlib import Path
+
+
 def safe_upload_path(base_dir, filename):
-    """Join an untrusted filename onto base_dir and return the path."""
-    raise NotImplementedError
+    """Return an absolute upload path inside base_dir, or raise ValueError."""
+    if not isinstance(filename, str) or not filename or "\x00" in filename:
+        raise ValueError("Invalid upload filename")
+    if ntpath.isabs(filename) or ntpath.splitdrive(filename)[0] or ntpath.isreserved(filename):
+        raise ValueError("Invalid upload filename")
+
+    base = Path(base_dir).resolve()
+    # Interpret both separators so traversal checks also work across platforms.
+    path = (base / filename.replace("\\", "/")).resolve()
+    if path == base or not path.is_relative_to(base):
+        raise ValueError("Upload path must stay inside base_dir")
+    return str(path)
