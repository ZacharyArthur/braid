+import ntpath
+import os
+
+
 def safe_upload_path(base_dir, filename):
-    """Join an untrusted filename onto base_dir and return the path."""
-    raise NotImplementedError
+    """Return an absolute path within base_dir, or raise ValueError."""
+    if not isinstance(filename, str) or not filename or "\0" in filename:
+        raise ValueError("Invalid upload filename")
+    if ntpath.isabs(filename) or ntpath.splitdrive(filename)[0] or ":" in filename:
+        raise ValueError("Upload filename must be relative")
+
+    base = os.path.realpath(base_dir)
+    path = os.path.realpath(os.path.join(base, filename.replace("\\", os.sep)))
+    if os.path.commonpath((base, path)) != base or path == base:
+        raise ValueError("Upload filename must stay within base_dir")
+    return path
