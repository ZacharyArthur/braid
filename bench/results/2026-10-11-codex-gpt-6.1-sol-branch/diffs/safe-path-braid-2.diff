+import os
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from uploads import safe_upload_path
+
+
+class SafeUploadPathTests(unittest.TestCase):
+    def test_paths(self):
+        base = Path(__file__).parent
+        for filename in ('image.png', 'nested/image.png', 'nested\\image.png'):
+            with self.subTest(filename=filename):
+                expected = os.path.realpath(base / filename.replace('\\', os.sep))
+                self.assertEqual(safe_upload_path(base, filename), expected)
+        for filename in (
+            '', '.', '..', '../outside', '../' + base.name + '-other/file',
+            '..\\outside', '/outside', '\\outside', 'C:\\outside',
+            'C:outside', '\\\\server\\share\\file', 'file:stream', 'a\0b',
+        ):
+            with self.subTest(filename=filename), self.assertRaises(ValueError):
+                safe_upload_path(base, filename)
+
+    def test_resolved_symlink_escape(self):
+        base = os.path.realpath(Path(__file__).parent)
+        outside = os.path.join(os.path.dirname(base), 'outside', 'file')
+        with patch('uploads.os.path.realpath', side_effect=[base, outside]):
+            with self.assertRaises(ValueError):
+                safe_upload_path(base, 'escape/file')
+
+
+if __name__ == '__main__':
+    unittest.main()
