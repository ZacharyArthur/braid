-from fastapi import FastAPI
+from collections import OrderedDict, deque
+from math import ceil
+from threading import Lock
+from time import monotonic
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+RATE_LIMIT_REQUESTS = 10
+RATE_LIMIT_WINDOW_SECONDS = 60
+
+# Process-local state: use shared storage when running multiple workers.
+_requests: OrderedDict[str, deque[float]] = OrderedDict()
+_rate_limit_lock = Lock()
+
+
+def limit_messages(request: Request):
+    # Use the ASGI client address, not untrusted forwarded headers.
+    client_ip = request.client.host if request.client else "unknown"
+    with _rate_limit_lock:
+        now = monotonic()
+        cutoff = now - RATE_LIMIT_WINDOW_SECONDS
+
+        # Buckets are ordered by their most recent accepted request.
+        while _requests:
+            oldest_ip = next(iter(_requests))
+            if _requests[oldest_ip][-1] > cutoff:
+                break
+            del _requests[oldest_ip]
+
+        timestamps = _requests.setdefault(client_ip, deque())
+        while timestamps and timestamps[0] <= cutoff:
+            timestamps.popleft()
+
+        if len(timestamps) >= RATE_LIMIT_REQUESTS:
+            retry_after = max(1, ceil(timestamps[0] + RATE_LIMIT_WINDOW_SECONDS - now))
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests. Please try again later.",
+                headers={"Retry-After": str(retry_after)},
+            )
+
+        timestamps.append(now)
+        _requests.move_to_end(client_ip)
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(limit_messages)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
