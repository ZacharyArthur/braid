+import re
+
+
+def is_valid_email(address: str) -> bool:
+    """Validate common ASCII email syntax, without checking deliverability."""
+    # shortcut(yagni): excludes quoted local parts and internationalized addresses; expand if needed.
+    if not isinstance(address, str) or len(address) > 254:
+        return False
+
+    local, separator, domain = address.rpartition("@")
+    if not separator or not 1 <= len(local) <= 64:
+        return False
+    if not re.fullmatch(r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*", local):
+        return False
+
+    labels = domain.split(".")
+    return len(labels) >= 2 and all(
+        re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", label)
+        is not None
+        for label in labels
+    )
