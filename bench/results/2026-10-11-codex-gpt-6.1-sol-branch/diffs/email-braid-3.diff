+import unittest
+
+from validate import is_valid_email
+
+
+class EmailValidationTests(unittest.TestCase):
+    def test_common_addresses_and_boundaries(self):
+        valid = ["alice@example.com", "a.b+tag@sub.example.org", "a" * 64 + "@example.com"]
+        invalid = [
+            None, "", "alice", "a@@example.com", "a@localhost",
+            ".a@example.com", "a..b@example.com", "a.@example.com",
+            "a@-example.com", "a@example-.com", "a@example..com",
+            "a@example.com\n", " a@example.com", "a b@example.com",
+            "a" * 65 + "@example.com", "a@" + "b" * 64 + ".com",
+            "a" * 64 + "@" + ".".join(["b" * 63] * 3),
+        ]
+        for address in valid + invalid:
+            with self.subTest(address=address):
+                self.assertEqual(is_valid_email(address), address in valid)
+
+
+if __name__ == "__main__":
+    unittest.main()
