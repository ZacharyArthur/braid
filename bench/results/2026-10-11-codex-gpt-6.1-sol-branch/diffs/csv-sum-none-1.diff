+import csv
+from decimal import Decimal
+
+
+def main():
+    with open("sales.csv", newline="", encoding="utf-8-sig") as file:
+        reader = csv.DictReader(file)
+        total = sum((Decimal(row["amount"]) for row in reader), Decimal("0"))
+    print(total)
+
+
+if __name__ == "__main__":
+    main()
