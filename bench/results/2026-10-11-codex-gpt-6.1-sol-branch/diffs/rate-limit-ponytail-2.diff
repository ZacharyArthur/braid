+from fastapi import FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+RATE_LIMIT = 10
+RATE_WINDOW = 60
+# shortcut: per-process memory, use a shared store when running multiple workers.
+_requests: dict[str, tuple[float, int]] = {}
+_requests_lock = Lock()
+
 
 class Message(BaseModel):
     text: str
 
 
 @app.post("/messages")
-def create_message(message: Message):
+def create_message(message: Message, request: Request):
+    client = request.client.host if request.client else "unknown"
+    with _requests_lock:
+        now = monotonic()
+        for key, (expires, _) in list(_requests.items()):
+            if expires <= now:
+                del _requests[key]
+        expires, count = _requests.get(client, (now + RATE_WINDOW, 0))
+        if count >= RATE_LIMIT:
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests",
+                headers={"Retry-After": str(ceil(expires - now))},
+            )
+        _requests[client] = (expires, count + 1)
     return {"ok": True, "length": len(message.text)}
