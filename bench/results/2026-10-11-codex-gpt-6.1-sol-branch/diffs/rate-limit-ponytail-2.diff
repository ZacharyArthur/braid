+import unittest
+from unittest.mock import patch
+
+from fastapi.testclient import TestClient
+
+import main
+
+
+class RateLimitTests(unittest.TestCase):
+    def setUp(self):
+        main._requests.clear()
+        self.client = TestClient(main.app)
+
+    def test_limit_and_window_reset(self):
+        with patch("main.monotonic", return_value=100):
+            for _ in range(main.RATE_LIMIT):
+                response = self.client.post("/messages", json={"text": "hello"})
+                self.assertEqual(response.status_code, 200)
+                self.assertEqual(response.json(), {"ok": True, "length": 5})
+            response = self.client.post("/messages", json={"text": "hello"})
+            self.assertEqual(response.status_code, 429)
+            self.assertEqual(response.headers["Retry-After"], "60")
+        with patch("main.monotonic", return_value=160):
+            self.assertEqual(
+                self.client.post("/messages", json={"text": "hello"}).status_code, 200
+            )
+            self.assertEqual(main._requests["testclient"][1], 1)
+
+    def test_clients_have_separate_limits(self):
+        main._requests["another-client"] = (float("inf"), main.RATE_LIMIT)
+        self.assertEqual(
+            self.client.post("/messages", json={"text": "hello"}).status_code, 200
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
