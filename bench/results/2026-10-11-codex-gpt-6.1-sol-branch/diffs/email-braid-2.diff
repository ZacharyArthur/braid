+++ b/validate.py
@@ -0,0 +1,33 @@
+import re
+
+
+def is_valid_email(address: str) -> bool:
+    """Validate common ASCII email syntax; this does not check deliverability."""
+    if not isinstance(address, str) or len(address) > 254:
+        return False
+    local, separator, domain = address.rpartition("@")
+    if not separator or not 1 <= len(local) <= 64 or not domain:
+        return False
+
+    # shortcut(kiss): excludes quoted local parts and Unicode; expand if needed.
+    if re.fullmatch(r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*", local) is None:
+        return False
+    return all(
+        re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", label)
+        is not None
+        for label in domain.split(".")
+    )
+
+
+if __name__ == "__main__":
+    for address in ("user@example.com", "first.last+tag@example.co.uk", "user@localhost"):
+        assert is_valid_email(address), address
+    for address in (
+        None, "", "user", "a@@example.com", "a..b@example.com",
+        ".a@example.com", "a.@example.com", "a@-example.com", "a@example-.com",
+        "a@example..com", "a@example.com\n", "a b@example.com",
+        "a" * 65 + "@example.com", "a@" + "b" * 64 + ".com",
+        "a@" + ".".join(["b" * 63] * 4),
+    ):
+        assert not is_valid_email(address), address
+    print("Email validation self-checks passed.")
