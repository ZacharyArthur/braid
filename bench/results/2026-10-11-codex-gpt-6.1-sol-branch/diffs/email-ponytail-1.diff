--- /dev/null
+++ b/validate.py
@@ -0,0 +1,32 @@
+import re
+
+
+def is_valid_email(address: str) -> bool:
+    """Validate common ASCII email syntax; this does not check deliverability."""
+    # shortcut: excludes quoted locals, IP literals and Unicode; upgrade for full RFC support.
+    if not isinstance(address, str) or len(address) > 254:
+        return False
+
+    local, separator, domain = address.rpartition("@")
+    if not separator or not 1 <= len(local) <= 64:
+        return False
+
+    atom = r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+"
+    label = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
+    return (
+        re.fullmatch(rf"{atom}(?:\.{atom})*", local) is not None
+        and re.fullmatch(rf"{label}(?:\.{label})+", domain) is not None
+    )
+
+
+if __name__ == "__main__":
+    for address in ("user@example.com", "first.last+tag@sub.example.org", "a@b.co"):
+        assert is_valid_email(address), address
+    for address in (
+        None, "", "a@localhost", "a@@example.com", "a..b@example.com",
+        ".a@example.com", "a.@example.com", "a@-example.com", "a@example-.com",
+        "a@exam_ple.com", "a@example.com\n", "a b@example.com",
+        "a" * 65 + "@example.com", "a@" + "b" * 64 + ".com",
+        "a" * 64 + "@" + ".".join(["b" * 63] * 3),
+    ):
+        assert not is_valid_email(address), address
