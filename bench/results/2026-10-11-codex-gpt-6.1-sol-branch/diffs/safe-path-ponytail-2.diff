+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from uploads import safe_upload_path
+
+
+class SafeUploadPathTests(unittest.TestCase):
+    def test_valid_filename(self):
+        directory = Path(__file__).parent
+        self.assertEqual(
+            safe_upload_path(directory, "photo.png"),
+            str(directory.resolve() / "photo.png"),
+        )
+
+    def test_rejects_unsafe_filenames(self):
+        for filename in (
+            "", ".", "..", "../escape", "..\\escape", "/etc/passwd",
+            "C:\\escape", "C:escape", "\\\\server\\share", "file:stream",
+            "folder/file", "folder\\file", "bad\0name", None,
+        ):
+            with self.subTest(filename=filename):
+                with self.assertRaises(ValueError):
+                    safe_upload_path("uploads", filename)
+
+    def test_rejects_symlink_escape(self):
+        root = Path(__file__).parent.resolve()
+        base = root / "uploads"
+        for target in (root / "outside", root / "uploads-other" / "file", base):
+            with self.subTest(target=target):
+                with patch.object(Path, "resolve", side_effect=(base, target)):
+                    with self.assertRaises(ValueError):
+                        safe_upload_path(base, "link")
+
+
+if __name__ == "__main__":
+    unittest.main()
