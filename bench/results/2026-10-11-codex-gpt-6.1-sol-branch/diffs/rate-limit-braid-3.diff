-from fastapi import FastAPI
+from math import ceil
+from threading import Lock
+from time import monotonic
+
+from fastapi import FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+REQUEST_LIMIT = 10
+WINDOW_SECONDS = 60
+# shortcut(kiss): counters are per process; use shared storage for multiple workers.
+_requests: dict[str, tuple[float, int]] = {}
+_rate_limit_lock = Lock()
+
 
 class Message(BaseModel):
     text: str
 
 
 @app.post("/messages")
-def create_message(message: Message):
+def create_message(message: Message, request: Request):
+    client = request.client.host if request.client else "unknown"
+    with _rate_limit_lock:
+        now = monotonic()
+        for host, (started, _) in list(_requests.items()):
+            if now - started >= WINDOW_SECONDS:
+                del _requests[host]
+        started, count = _requests.get(client, (now, 0))
+        if count >= REQUEST_LIMIT:
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests",
+                headers={"Retry-After": str(ceil(WINDOW_SECONDS - (now - started)))},
+            )
+        _requests[client] = (started, count + 1)
     return {"ok": True, "length": len(message.text)}
