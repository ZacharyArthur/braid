+import csv
+from decimal import Decimal
+
+
+def main():
+    with open("sales.csv", newline="", encoding="utf-8-sig") as sales_file:
+        rows = csv.DictReader(sales_file)
+        total = sum((Decimal(row["amount"]) for row in rows), Decimal("0"))
+    print(total)
+
+
+if __name__ == "__main__":
+    main()
