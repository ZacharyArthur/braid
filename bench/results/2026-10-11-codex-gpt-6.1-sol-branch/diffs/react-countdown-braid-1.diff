+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+
+// Check timer behavior without requiring a React installation or JSX tooling.
+const source = fs.readFileSync(`${__dirname}/Countdown.jsx`, 'utf8')
+  .replace(/^import .*;\n/, '')
+  .replace('export default function', 'function')
+  .replace('<span role="timer">{remaining}</span>', 'remaining');
+let effect, cleanup, value, tick;
+const context = vm.createContext({
+  useState: initial => [value = initial, next => { value = next; }],
+  useEffect: callback => { effect = callback; },
+  setInterval: (callback, delay) => {
+    assert.equal(delay, 1000);
+    tick = callback;
+    return 1;
+  },
+  clearInterval: () => { tick = undefined; },
+});
+vm.runInContext(source, context);
+const start = seconds => {
+  cleanup?.();
+  context.Countdown({ seconds });
+  cleanup = effect();
+};
+start(2);
+assert.equal(value, 2);
+tick();
+assert.equal(value, 1);
+tick();
+assert.equal(value, 0);
+assert.equal(tick, undefined);
+start(5);
+tick();
+start(3);
+assert.equal(value, 3);
+cleanup();
+assert.equal(tick, undefined);
+for (const seconds of [0, -1, NaN, Infinity, '3', undefined]) {
+  start(seconds);
+  assert.equal(value, 0);
+  assert.equal(tick, undefined);
+}
+start(2.9);
+assert.equal(value, 2);
+cleanup();
+console.log('Countdown checks passed');
