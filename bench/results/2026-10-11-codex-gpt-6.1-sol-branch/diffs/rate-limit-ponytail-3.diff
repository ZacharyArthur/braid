@@ -0,0 +1,41 @@
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import main
+
+
+class RateLimitTests(unittest.TestCase):
+    def setUp(self):
+        main._requests.clear()
+        self.clock = patch("main.monotonic", return_value=100)
+        self.now = self.clock.start()
+        self.addCleanup(self.clock.stop)
+        self.addCleanup(main._requests.clear)
+        self.request = SimpleNamespace(client=SimpleNamespace(host="127.0.0.1"))
+
+    def test_limit_and_independent_clients(self):
+        for _ in range(main.RATE_LIMIT):
+            main.check_rate_limit(self.request)
+        with self.assertRaises(main.HTTPException) as caught:
+            main.check_rate_limit(self.request)
+        self.assertEqual(caught.exception.status_code, 429)
+        self.assertEqual(caught.exception.headers, {"Retry-After": "60"})
+        main.check_rate_limit(SimpleNamespace(client=SimpleNamespace(host="127.0.0.2")))
+
+    def test_window_expiry_and_cleanup(self):
+        for _ in range(main.RATE_LIMIT):
+            main.check_rate_limit(self.request)
+        self.now.return_value = 159.5
+        with self.assertRaises(main.HTTPException) as caught:
+            main.check_rate_limit(self.request)
+        self.assertEqual(caught.exception.headers["Retry-After"], "1")
+        self.now.return_value = 160
+        main.check_rate_limit(SimpleNamespace(client=None))
+        self.assertNotIn("127.0.0.1", main._requests)
+        main.check_rate_limit(self.request)
+        self.assertEqual(list(main._requests["127.0.0.1"]), [160])
+
+
+if __name__ == "__main__":
+    unittest.main()
