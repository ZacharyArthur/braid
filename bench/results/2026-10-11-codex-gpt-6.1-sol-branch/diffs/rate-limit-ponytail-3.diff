-from fastapi import FastAPI
+from collections import deque
+from math import ceil
+from threading import Lock
+from time import monotonic
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+RATE_LIMIT = 10
+RATE_WINDOW = 60
+_requests = {}
+_requests_lock = Lock()
+
+
+# shortcut: counters are per process, use a shared store for multiple workers.
+def check_rate_limit(request: Request):
+    client = request.client.host if request.client else "unknown"
+    with _requests_lock:
+        now = monotonic()
+        for key, timestamps in list(_requests.items()):
+            while timestamps and timestamps[0] <= now - RATE_WINDOW:
+                timestamps.popleft()
+            if not timestamps:
+                del _requests[key]
+        timestamps = _requests.setdefault(client, deque())
+        if len(timestamps) >= RATE_LIMIT:
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests",
+                headers={"Retry-After": str(ceil(timestamps[0] + RATE_WINDOW - now))},
+            )
+        timestamps.append(now)
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(check_rate_limit)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
