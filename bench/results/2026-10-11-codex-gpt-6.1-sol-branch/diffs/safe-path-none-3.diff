+import os
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from uploads import safe_upload_path
+
+
+class SafeUploadPathTests(unittest.TestCase):
+    def test_normal_filename(self):
+        directory = Path(__file__).resolve().parent
+        self.assertEqual(
+            safe_upload_path(directory, "report 2026.txt"),
+            os.path.join(os.path.realpath(directory), "report 2026.txt"),
+        )
+
+    def test_rejects_untrusted_paths(self):
+        for filename in (
+            "", ".", "..", "../secret", "..\\secret", "/secret",
+            "C:\\secret", "C:secret", "\\\\server\\share\\secret",
+            "folder/file", "folder\\file", "file:stream", "bad\x00name",
+        ):
+            with self.subTest(filename=filename):
+                with self.assertRaises(ValueError):
+                    safe_upload_path("uploads", filename)
+
+    def test_rejects_non_string_filename(self):
+        for filename in (None, b"file.txt", 123):
+            with self.subTest(filename=filename):
+                with self.assertRaises(TypeError):
+                    safe_upload_path("uploads", filename)
+
+    def test_rejects_symlink_to_sibling_directory(self):
+        directory = Path(__file__).resolve().parent
+        base = str(directory / "uploads")
+        outside = str(directory / "uploads-other")
+        with patch("uploads.os.path.realpath", side_effect=[base, outside]):
+            with self.assertRaises(ValueError):
+                safe_upload_path(base, "escape")
+
+
+if __name__ == "__main__":
+    unittest.main()
