+import ntpath
+import os
+
+
 def safe_upload_path(base_dir, filename):
-    """Join an untrusted filename onto base_dir and return the path."""
-    raise NotImplementedError
+    """Return an absolute upload path for a single untrusted filename.
+
+    Raise ValueError for invalid filenames or paths that resolve outside the
+    base directory. Callers must prevent concurrent changes to symlinks in the
+    upload directory between this check and opening the file.
+    """
+    if not isinstance(filename, str):
+        raise TypeError("filename must be a string")
+    if (
+        not filename
+        or filename in (".", "..")
+        or any(char in filename for char in ("/", "\\", "\x00", ":"))
+        or ntpath.splitdrive(filename)[0]
+    ):
+        raise ValueError("filename must be a single file name")
+
+    base = os.path.realpath(os.fsdecode(base_dir))
+    path = os.path.realpath(os.path.join(base, filename))
+    try:
+        contained = os.path.commonpath((base, path)) == base
+    except ValueError:
+        contained = False
+    if not contained or path == base:
+        raise ValueError("upload path must stay inside base_dir")
+    return path
