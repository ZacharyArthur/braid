@@ -0,0 +1,29 @@
+"""Validation for common email address syntax."""
+
+import re
+
+
+_LOCAL_PART = re.compile(r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*")
+_DOMAIN_LABEL = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?")
+
+
+def is_valid_email(address: str) -> bool:
+    """Check a common ASCII email address without checking deliverability.
+
+    Requires an unquoted local part and a dotted domain name. Quoted local
+    parts, IP address literals, display names, and internationalized addresses
+    are not supported. Non-string inputs return False.
+    """
+    if not isinstance(address, str) or len(address) > 254:
+        return False
+    if address.count("@") != 1:
+        return False
+
+    local, domain = address.split("@")
+    if len(local) > 64 or _LOCAL_PART.fullmatch(local) is None:
+        return False
+
+    labels = domain.split(".")
+    return len(labels) >= 2 and all(
+        _DOMAIN_LABEL.fullmatch(label) is not None for label in labels
+    )
