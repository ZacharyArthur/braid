@@ -0,0 +1,15 @@
+import re
+
+
+_ATOM = r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+"
+_LABEL = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
+_EMAIL = re.compile(rf"{_ATOM}(?:\.{_ATOM})*@{_LABEL}(?:\.{_LABEL})+")
+
+
+def is_valid_email(address: str) -> bool:
+    """Validate common ASCII email syntax; this does not verify deliverability."""
+    # shortcut: excludes quoted/internationalized addresses, upgrade if needed.
+    if not isinstance(address, str) or len(address) > 254:
+        return False
+    local, separator, _ = address.partition("@")
+    return bool(separator and len(local) <= 64 and _EMAIL.fullmatch(address))
