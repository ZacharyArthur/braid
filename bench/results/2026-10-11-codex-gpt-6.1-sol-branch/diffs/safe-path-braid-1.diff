+import os
+import unittest
+from unittest.mock import patch
+
+from uploads import safe_upload_path
+
+
+class SafeUploadPathTests(unittest.TestCase):
+    def test_regular_filename(self):
+        base = "uploads"
+        self.assertEqual(
+            safe_upload_path(base, "report 2026.txt"),
+            os.path.join(os.path.realpath(base), "report 2026.txt"),
+        )
+
+    def test_rejects_unsafe_filenames(self):
+        for filename in (
+            "", ".", "..", "../secret", "..\\secret", "/secret",
+            "C:\\secret", "C:secret", "\\\\server\\share", "file:stream",
+            "nested/file", "bad\x00name", None, b"file",
+        ):
+            with self.subTest(filename=filename), self.assertRaises(ValueError):
+                safe_upload_path("uploads", filename)
+
+    def test_rejects_resolved_path_outside_base(self):
+        # Simulate symlink resolution without requiring Windows symlink privileges.
+        base = os.path.abspath("uploads")
+        outside = os.path.abspath("uploads-other/secret")
+        with patch("uploads.os.path.realpath", side_effect=[base, outside]):
+            with self.assertRaises(ValueError):
+                safe_upload_path(base, "link")
+
+
+if __name__ == "__main__":
+    unittest.main()
