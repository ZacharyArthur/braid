-from fastapi import FastAPI
+from collections import deque
+from math import ceil
+from threading import Lock
+from time import monotonic
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+REQUEST_LIMIT = 10
+WINDOW_SECONDS = 60
+_requests = {}
+_lock = Lock()
+
+
+def rate_limit(request: Request):
+    # shortcut(kiss): limits are per process; use shared storage for multiple workers.
+    client = request.client.host if request.client else "unknown"
+    with _lock:
+        now = monotonic()
+        for key in list(_requests):
+            timestamps = _requests[key]
+            while timestamps and timestamps[0] <= now - WINDOW_SECONDS:
+                timestamps.popleft()
+            if not timestamps:
+                del _requests[key]
+        timestamps = _requests.setdefault(client, deque())
+        if len(timestamps) >= REQUEST_LIMIT:
+            retry_after = ceil(timestamps[0] + WINDOW_SECONDS - now)
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests",
+                headers={"Retry-After": str(retry_after)},
+            )
+        timestamps.append(now)
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(rate_limit)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
