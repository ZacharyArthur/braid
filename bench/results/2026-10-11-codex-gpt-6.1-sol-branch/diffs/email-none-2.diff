+"""Practical validation of common email address syntax."""
+
+import re
+
+
+_LOCAL_PART = re.compile(r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~.-]+", re.ASCII)
+_DOMAIN_LABEL = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", re.ASCII)
+
+
+def is_valid_email(address: str) -> bool:
+    """Validate an unquoted ASCII email address with a dotted domain.
+
+    Reject surrounding whitespace, quoted local parts, and domain literals.
+    This checks syntax only; it does not establish that a mailbox exists.
+    """
+    if not isinstance(address, str) or len(address) > 254:
+        return False
+    if address.count("@") != 1:
+        return False
+
+    local, domain = address.split("@")
+    if not 1 <= len(local) <= 64 or not _LOCAL_PART.fullmatch(local):
+        return False
+    if local.startswith(".") or local.endswith(".") or ".." in local:
+        return False
+
+    labels = domain.split(".")
+    return len(labels) >= 2 and all(
+        _DOMAIN_LABEL.fullmatch(label) is not None for label in labels
+    )
