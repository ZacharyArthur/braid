+import os
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from uploads import safe_upload_path
+
+
+class SafeUploadPathTests(unittest.TestCase):
+    def test_valid_filename(self):
+        base = Path(__file__).parent
+        self.assertEqual(
+            safe_upload_path(base, "report résumé.txt"),
+            os.path.join(os.path.realpath(base), "report résumé.txt"),
+        )
+
+    def test_unsafe_filenames(self):
+        for filename in (
+            "", ".", "..", "../secret", "..\\secret", "/secret",
+            "C:\\secret", "C:secret", "\\\\server\\share", "sub/file",
+            "sub\\file", "file:stream", "file\0.txt", "CON", "NUL.txt",
+            None, b"file.txt",
+        ):
+            with self.subTest(filename=filename), self.assertRaises(ValueError):
+                safe_upload_path("uploads", filename)
+
+    def test_symlink_escape(self):
+        root = Path(__file__).parent
+        base = str(root / "uploads")
+        for target in (str(root / "secret"), str(root / "uploads-other"), base):
+            with self.subTest(target=target):
+                with patch("uploads.os.path.realpath", side_effect=[base, target]):
+                    with self.assertRaises(ValueError):
+                        safe_upload_path(base, "link")
+
+
+if __name__ == "__main__":
+    unittest.main()
