+import ntpath
+import os
+
+
 def safe_upload_path(base_dir, filename):
-    """Join an untrusted filename onto base_dir and return the path."""
-    raise NotImplementedError
+    """Return an absolute upload path; raise ValueError for unsafe filenames.
+
+    The upload directory must not be writable by untrusted users: this check
+    cannot prevent symlinks from being changed before the caller opens the file.
+    """
+    if (
+        not isinstance(filename, str)
+        or not filename
+        or filename in (".", "..")
+        or any(char in filename for char in ("/", "\\", ":", "\0"))
+        or ntpath.isreserved(filename)
+    ):
+        raise ValueError("filename must be a single, ordinary file name")
+
+    base = os.path.realpath(base_dir)
+    path = os.path.realpath(os.path.join(base, filename))
+    if os.path.commonpath((base, path)) != base or path == base:
+        raise ValueError("upload path must stay inside base_dir")
+    return path
