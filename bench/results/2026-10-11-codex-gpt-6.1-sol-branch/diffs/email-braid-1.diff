+import unittest
+
+from validate import is_valid_email
+
+
+class EmailValidationTests(unittest.TestCase):
+    def test_valid_addresses(self):
+        for address in ("user@example.com", "first.last+tag@sub.example.co.uk",
+                        "o'connor@example.com", "a" * 64 + "@example.com"):
+            with self.subTest(address=address):
+                self.assertTrue(is_valid_email(address))
+
+    def test_invalid_addresses(self):
+        for address in (None, 42, "", "user", "@example.com", "user@",
+                        "user@@example.com", " user@example.com", "user@example.com\n",
+                        ".user@example.com", "user.@example.com", "u..ser@example.com",
+                        "user@localhost", "user@-example.com", "user@example-.com",
+                        "user@exam_ple.com", "user@example..com", "user@example.com.",
+                        "a" * 65 + "@example.com", "user@" + "a" * 64 + ".com",
+                        "a" * 64 + "@" + ".".join(["b" * 63] * 3 + ["com"])):
+            with self.subTest(address=address):
+                self.assertFalse(is_valid_email(address))
+
+
+if __name__ == "__main__":
+    unittest.main()
