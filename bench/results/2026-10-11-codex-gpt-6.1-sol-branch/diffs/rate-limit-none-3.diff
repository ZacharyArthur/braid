+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from unittest.mock import patch
+
+from fastapi import HTTPException
+from fastapi.testclient import TestClient
+
+import main
+
+
+class RateLimitTests(unittest.TestCase):
+    def setUp(self):
+        self.limiter = main.RateLimiter()
+        self.override = patch.object(main, "message_limiter", self.limiter)
+        self.override.start()
+        self.addCleanup(self.override.stop)
+        self.client = TestClient(main.app)
+
+    def test_endpoint_limit_and_retry_header(self):
+        with patch.object(main, "monotonic", return_value=100):
+            for _ in range(10):
+                response = self.client.post("/messages", json={"text": "hello"})
+                self.assertEqual(response.status_code, 200)
+                self.assertEqual(response.json(), {"ok": True, "length": 5})
+            response = self.client.post("/messages", json={"text": "hello"})
+            self.assertEqual(response.status_code, 429)
+            self.assertEqual(response.headers["Retry-After"], "60")
+            # Spoofing a forwarded address cannot bypass the limit.
+            response = self.client.post(
+                "/messages", json={"text": "hello"},
+                headers={"X-Forwarded-For": "192.0.2.99"},
+            )
+            self.assertEqual(response.status_code, 429)
+
+    def test_independent_clients_and_expiry(self):
+        with patch.object(main, "monotonic", return_value=100):
+            for _ in range(10):
+                self.limiter.check("client-a")
+            self.limiter.check("client-b")
+        with patch.object(main, "monotonic", return_value=159.2):
+            with self.assertRaises(HTTPException) as raised:
+                self.limiter.check("client-a")
+            self.assertEqual(raised.exception.headers["Retry-After"], "1")
+        with patch.object(main, "monotonic", return_value=160):
+            self.limiter.check("client-a")
+            self.assertNotIn("client-b", self.limiter._requests)
+
+    def test_concurrent_requests_cannot_exceed_limit(self):
+        def attempt(_):
+            try:
+                self.limiter.check("shared-client")
+                return True
+            except HTTPException:
+                return False
+
+        with patch.object(main, "monotonic", return_value=100):
+            with ThreadPoolExecutor(max_workers=20) as pool:
+                self.assertEqual(sum(pool.map(attempt, range(50))), 10)
+
+
+if __name__ == "__main__":
+    unittest.main()
