+class RateLimiter:
+    """Thread-safe sliding window, scoped to this application process."""
+
+    def __init__(self, limit: int = 10, window: float = 60):
+        self.limit = limit
+        self.window = window
+        self._requests: dict[str, deque[float]] = {}
+        self._lock = Lock()
+
+    def check(self, client: str) -> None:
+        with self._lock:
+            now = monotonic()
+            cutoff = now - self.window
+            # Drop inactive clients so history does not grow indefinitely.
+            for key in list(self._requests):
+                timestamps = self._requests[key]
+                while timestamps and timestamps[0] <= cutoff:
+                    timestamps.popleft()
+                if not timestamps:
+                    del self._requests[key]
+
+            timestamps = self._requests.setdefault(client, deque())
+            if len(timestamps) >= self.limit:
+                retry_after = max(1, ceil(timestamps[0] + self.window - now))
+                raise HTTPException(
+                    status_code=429,
+                    detail="Too many requests. Try again later.",
+                    headers={"Retry-After": str(retry_after)},
+                )
+            timestamps.append(now)
+
+
+message_limiter = RateLimiter()
+
+
+def limit_messages(request: Request) -> None:
+    # Use the connection peer; do not trust arbitrary forwarded IP headers.
+    client = request.client.host if request.client else "unknown"
+    message_limiter.check(client)
+
