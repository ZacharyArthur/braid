diff --git a/digest.py b/digest.py
index 1fa547b..ebe781f 100644
--- a/digest.py
+++ b/digest.py
@@ -3,5 +3,6 @@ import mailer
 
 def send_digest(subscribers, text):
     """Email the weekly digest to every subscriber."""
-    for address in subscribers:
-        mailer.send(address, "Weekly digest", text)
+    recipients = list(subscribers)
+    if recipients:
+        mailer.send(recipients, "Weekly digest", text)
diff --git a/mailer.py b/mailer.py
index 9bce7eb..416ec80 100644
--- a/mailer.py
+++ b/mailer.py
@@ -2,5 +2,5 @@ OUTBOX = []  # sent messages; the provider client reads from here
 
 
 def send(to, subject, body):
-    """Send one email. `to` is the recipient address."""
+    """Send one email. `to` is an address or a list of recipient addresses."""
     OUTBOX.append({"to": to, "subject": subject, "body": body})
diff --git a/tests/test_mailer.py b/tests/test_mailer.py
index faf8d01..763ca11 100644
--- a/tests/test_mailer.py
+++ b/tests/test_mailer.py
@@ -1,5 +1,6 @@
 import mailer
 import signup
+import digest
 
 
 def test_send():
@@ -12,3 +13,26 @@ def test_welcome():
     mailer.OUTBOX.clear()
     signup.welcome("new@example.com")
     assert mailer.OUTBOX[-1]["subject"] == "Welcome!"
+    assert mailer.OUTBOX[-1]["to"] == "new@example.com"
+
+
+def test_send_multiple_recipients():
+    mailer.OUTBOX.clear()
+    recipients = ["a@example.com", "b@example.com"]
+    mailer.send(recipients, "Hi", "Body")
+    assert mailer.OUTBOX == [{"to": recipients, "subject": "Hi", "body": "Body"}]
+
+
+def test_digest_sends_one_message():
+    mailer.OUTBOX.clear()
+    recipients = ["a@example.com", "b@example.com"]
+    digest.send_digest(iter(recipients), "This week's news")
+    assert mailer.OUTBOX == [
+        {"to": recipients, "subject": "Weekly digest", "body": "This week's news"}
+    ]
+
+
+def test_digest_without_subscribers():
+    mailer.OUTBOX.clear()
+    digest.send_digest([], "This week's news")
+    assert mailer.OUTBOX == []
