+import unittest
+from unittest.mock import patch
+
+from fastapi.testclient import TestClient
+
+from main import RATE_LIMIT, WINDOW_SECONDS, app, request_counts
+
+
+class RateLimitTests(unittest.TestCase):
+    def setUp(self):
+        request_counts.clear()
+        self.client = TestClient(app)
+
+    def test_limit_and_window_reset(self):
+        with patch("main.monotonic", return_value=100):
+            for _ in range(RATE_LIMIT):
+                response = self.client.post("/messages", json={"text": "hello"})
+                self.assertEqual(response.status_code, 200)
+                self.assertEqual(response.json(), {"ok": True, "length": 5})
+            response = self.client.post("/messages", json={"text": "hello"})
+            self.assertEqual(response.status_code, 429)
+            self.assertEqual(response.headers["Retry-After"], str(WINDOW_SECONDS))
+        with patch("main.monotonic", return_value=100 + WINDOW_SECONDS):
+            response = self.client.post("/messages", json={"text": "hello"})
+            self.assertEqual(response.status_code, 200)
+
+    def test_clients_have_separate_limits(self):
+        with patch("main.monotonic", return_value=100):
+            for _ in range(RATE_LIMIT):
+                self.client.post("/messages", json={"text": "hello"})
+            other_client = TestClient(app, client=("other-client", 123))
+            response = other_client.post("/messages", json={"text": "hello"})
+            self.assertEqual(response.status_code, 200)
+
+
+if __name__ == "__main__":
+    unittest.main()
