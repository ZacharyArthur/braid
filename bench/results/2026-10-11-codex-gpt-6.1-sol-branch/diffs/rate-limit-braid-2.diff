-from fastapi import FastAPI
+from math import ceil
+from threading import Lock
+from time import monotonic
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
+RATE_LIMIT = 10
+WINDOW_SECONDS = 60
+# shortcut(kiss): Limits are per process; use shared storage for multiple workers.
+request_counts: dict[str, tuple[float, int]] = {}
+rate_limit_lock = Lock()
+
+
+def check_rate_limit(request: Request):
+    client_ip = request.client.host if request.client else "unknown"
+    with rate_limit_lock:
+        now = monotonic()
+        for ip, (start, _) in list(request_counts.items()):
+            if now - start >= WINDOW_SECONDS:
+                del request_counts[ip]
+        start, count = request_counts.get(client_ip, (now, 0))
+        if count >= RATE_LIMIT:
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests",
+                headers={"Retry-After": str(ceil(WINDOW_SECONDS - (now - start)))},
+            )
+        request_counts[client_ip] = (start, count + 1)
 
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(check_rate_limit)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
