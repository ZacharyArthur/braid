+import os
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from uploads import safe_upload_path
+
+
+class SafeUploadPathTests(unittest.TestCase):
+    def test_valid_filename(self):
+        base = Path.cwd()
+        self.assertEqual(
+            safe_upload_path(base, "photo.png"),
+            os.path.join(os.path.realpath(base), "photo.png"),
+        )
+
+    def test_unsafe_filenames(self):
+        base = Path.cwd()
+        for filename in (
+            "", ".", "..", "../secret", "..\\secret", "/secret",
+            "C:\\secret", "C:secret", "\\\\server\\secret",
+            "photo.png:stream", "folder/photo.png", "bad\0name", None,
+        ):
+            with self.subTest(filename=filename), self.assertRaises(ValueError):
+                safe_upload_path(base, filename)
+
+    def test_symlink_escape(self):
+        base = str(Path.cwd() / "uploads")
+        outside = str(Path.cwd() / "secret")
+        with patch("uploads.os.path.realpath", side_effect=[base, outside]):
+            with self.assertRaises(ValueError):
+                safe_upload_path(base, "photo.png")
+
+
+if __name__ == "__main__":
+    unittest.main()
