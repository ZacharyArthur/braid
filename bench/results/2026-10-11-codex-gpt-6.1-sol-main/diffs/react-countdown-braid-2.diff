+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+
+// Exercise the component's effects without installing React or a JSX toolchain.
+let remaining, tick, cleanup;
+let active = false;
+const effects = [];
+const source = fs.readFileSync(`${__dirname}/Countdown.jsx`, 'utf8')
+  .replace(/^import .*;\r?\n/, '')
+  .replace('export default function', 'function')
+  .replace(/return <span>.*<\/span>;/, 'return remaining;');
+const context = vm.createContext({
+  useState: (initial) => [remaining = initial, (value) => { remaining = value; }],
+  useEffect: (effect) => effects.push(effect),
+  setInterval: (callback, delay) => {
+    assert.equal(delay, 1000);
+    tick = callback;
+    active = true;
+    return 1;
+  },
+  clearInterval: () => { active = false; },
+});
+vm.runInContext(source, context);
+
+function start(seconds) {
+  cleanup?.();
+  context.Countdown({ seconds });
+  cleanup = effects.pop()();
+}
+
+start(2);
+assert.equal(remaining, 2);
+tick();
+assert.equal(remaining, 1);
+tick();
+assert.equal(remaining, 0);
+assert.equal(active, false);
+start(5);
+tick();
+start(3);
+assert.equal(remaining, 3);
+cleanup();
+assert.equal(active, false);
+for (const seconds of [0, -1, NaN, Infinity, undefined]) {
+  start(seconds);
+  assert.equal(remaining, 0);
+  assert.equal(active, false);
+}
+start(2.9);
+assert.equal(remaining, 2);
+cleanup();
+console.log('Countdown checks passed');
