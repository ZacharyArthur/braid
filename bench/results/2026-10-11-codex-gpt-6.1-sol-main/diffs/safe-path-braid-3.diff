+import os
+import unittest
+
+from uploads import safe_upload_path
+
+
+class SafeUploadPathTests(unittest.TestCase):
+    def test_paths(self):
+        base = os.path.realpath(os.path.dirname(__file__))
+        self.assertEqual(safe_upload_path(base, "photo.jpg"), os.path.join(base, "photo.jpg"))
+        self.assertEqual(safe_upload_path(base, "nested/photo.jpg"), os.path.join(base, "nested", "photo.jpg"))
+        for filename in ("", ".", "..", "../outside", "../" + os.path.basename(base) + "-other/file",
+                         os.path.join(base, "outside"), "/outside", "\\outside", "../nested/../../outside",
+                         "..\\outside", "C:\\outside", "C:outside", "\\\\server\\share\\file", "bad\0name", None):
+            with self.subTest(filename=filename), self.assertRaises(ValueError):
+                safe_upload_path(base, filename)
+
+
+if __name__ == "__main__":
+    unittest.main()
