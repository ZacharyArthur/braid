+from pathlib import Path, PureWindowsPath
+
+
 def safe_upload_path(base_dir, filename):
-    """Join an untrusted filename onto base_dir and return the path."""
-    raise NotImplementedError
+    """Return a resolved upload path within base_dir, or raise ValueError."""
+    if not isinstance(filename, str) or not filename or "\0" in filename:
+        raise ValueError("Invalid upload filename")
+    # Treat both separator styles as paths, regardless of the host platform.
+    name = filename.replace("\\", "/")
+    if PureWindowsPath(name).anchor or ":" in name:
+        raise ValueError("Upload filename must be relative")
+    base = Path(base_dir).resolve()
+    path = (base / name).resolve()
+    try:
+        path.relative_to(base)
+    except ValueError:
+        raise ValueError("Upload path escapes base_dir") from None
+    if path == base:
+        raise ValueError("Upload filename must name a file")
+    return str(path)
