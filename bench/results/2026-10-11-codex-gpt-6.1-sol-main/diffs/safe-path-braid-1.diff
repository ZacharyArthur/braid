@@ -0,0 +1,23 @@
+from pathlib import Path
+
+from uploads import safe_upload_path
+
+
+def test_safe_upload_path():
+    base = Path(__file__).parent.resolve() / "uploads"
+    assert safe_upload_path(base, "photo.jpg") == str(base / "photo.jpg")
+    assert safe_upload_path(base, "nested/photo.jpg") == str(base / "nested" / "photo.jpg")
+    for name in ("", ".", "..", "../outside", "../uploads-other/file",
+                 "..\\outside", "/outside", "C:\\outside", "C:outside",
+                 "\\\\server\\share\\file", "file:stream", "bad\0name"):
+        try:
+            safe_upload_path(base, name)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError(f"Accepted unsafe filename: {name!r}")
+
+
+if __name__ == "__main__":
+    test_safe_upload_path()
+    print("safe_upload_path checks passed")
