diff --git a/tests/test_mailer.py b/tests/test_mailer.py
index faf8d01..6508037 100644
--- a/tests/test_mailer.py
+++ b/tests/test_mailer.py
@@ -1,5 +1,6 @@
 import mailer
 import signup
+import digest
 
 
 def test_send():
@@ -12,3 +13,29 @@ def test_welcome():
     mailer.OUTBOX.clear()
     signup.welcome("new@example.com")
     assert mailer.OUTBOX[-1]["subject"] == "Welcome!"
+
+
+def test_send_multiple_recipients():
+    mailer.OUTBOX.clear()
+    mailer.send(["a@example.com", "b@example.com"], "Hi", "Body")
+    assert mailer.OUTBOX == [{
+        "to": ["a@example.com", "b@example.com"],
+        "subject": "Hi",
+        "body": "Body",
+    }]
+
+
+def test_digest_sends_one_message():
+    mailer.OUTBOX.clear()
+    digest.send_digest(["a@example.com", "b@example.com"], "News")
+    assert mailer.OUTBOX == [{
+        "to": ["a@example.com", "b@example.com"],
+        "subject": "Weekly digest",
+        "body": "News",
+    }]
+
+
+def test_digest_without_subscribers():
+    mailer.OUTBOX.clear()
+    digest.send_digest([], "News")
+    assert mailer.OUTBOX == []
