+from fastapi import FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+RATE_LIMIT = 10
+WINDOW_SECONDS = 60
+# braid(yagni): per-process counters; use shared storage for multiple workers.
+requests_by_ip: dict[str, tuple[float, int]] = {}
+rate_limit_lock = Lock()
+
 
 class Message(BaseModel):
     text: str
 
 
 @app.post("/messages")
-def create_message(message: Message):
+def create_message(message: Message, request: Request):
+    ip = request.client.host if request.client else "unknown"
+    with rate_limit_lock:
+        now = monotonic()
+        for client, (started, _) in list(requests_by_ip.items()):
+            if now - started >= WINDOW_SECONDS:
+                del requests_by_ip[client]
+        started, count = requests_by_ip.get(ip, (now, 0))
+        if count >= RATE_LIMIT:
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests",
+                headers={"Retry-After": str(ceil(WINDOW_SECONDS - (now - started)))},
+            )
+        requests_by_ip[ip] = (started, count + 1)
     return {"ok": True, "length": len(message.text)}
