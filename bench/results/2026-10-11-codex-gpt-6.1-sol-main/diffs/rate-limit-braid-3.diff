+import unittest
+from unittest.mock import patch
+
+from fastapi.testclient import TestClient
+
+import main
+
+
+class RateLimitTest(unittest.TestCase):
+    def test_limit_isolation_and_expiry(self):
+        main.requests_by_ip.clear()
+        with patch("main.monotonic", return_value=100) as clock:
+            with TestClient(main.app) as client:
+                for _ in range(main.RATE_LIMIT):
+                    response = client.post("/messages", json={"text": "hello"})
+                    self.assertEqual(response.status_code, 200)
+                    self.assertEqual(response.json(), {"ok": True, "length": 5})
+                response = client.post("/messages", json={"text": "hello"})
+                self.assertEqual(response.status_code, 429)
+                self.assertEqual(response.headers["Retry-After"], "60")
+                # Forwarded headers must not let clients bypass their limit.
+                response = client.post("/messages", json={"text": "hello"},
+                                       headers={"X-Forwarded-For": "another-ip"})
+                self.assertEqual(response.status_code, 429)
+                with TestClient(main.app, client=("another-ip", 123)) as other:
+                    self.assertEqual(other.post("/messages", json={"text": "hi"}).status_code, 200)
+                clock.return_value = 160
+                self.assertEqual(client.post("/messages", json={"text": "hello"}).status_code, 200)
+
+
+if __name__ == "__main__":
+    unittest.main()
