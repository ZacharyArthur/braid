new file mode 100644
index 0000000..40bd2e5
--- /dev/null
+++ b/debounce.js
@@ -0,0 +1,10 @@
+function debounce(fn, delay) {
+  let timeout;
+
+  return function (...args) {
+    clearTimeout(timeout);
+    timeout = setTimeout(() => fn.apply(this, args), delay);
+  };
+}
+
+module.exports = debounce;
diff --git a/debounce.test.js b/debounce.test.js
new file mode 100644
index 0000000..d194853
--- /dev/null
+++ b/debounce.test.js
@@ -0,0 +1,27 @@
+const assert = require('node:assert/strict');
+const debounce = require('./debounce');
+
+async function test() {
+  const calls = [];
+  const context = {};
+  const debounced = debounce(function (...args) {
+    calls.push({ context: this, args });
+  }, 30);
+
+  debounced('first');
+  debounced.call(context, 'last', 42);
+  assert.equal(calls.length, 0);
+  await new Promise(resolve => setTimeout(resolve, 60));
+  assert.deepEqual(calls, [{ context, args: ['last', 42] }]);
+
+  debounced.call(context, 'next');
+  await new Promise(resolve => setTimeout(resolve, 60));
+  assert.equal(calls.length, 2);
+  assert.deepEqual(calls[1], { context, args: ['next'] });
+  console.log('Debounce checks passed');
+}
+
+test().catch(error => {
+  console.error(error);
+  process.exitCode = 1;
+});
