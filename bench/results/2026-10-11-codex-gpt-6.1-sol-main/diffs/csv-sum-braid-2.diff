+import csv
+from decimal import Decimal
+
+with open("sales.csv", newline="", encoding="utf-8-sig") as sales:
+    total = sum((Decimal(row["amount"]) for row in csv.DictReader(sales)), Decimal("0"))
+
+print(total)
diff --git a/test_sum_sales.py b/test_sum_sales.py
new file mode 100644
index 0000000..764ffd0
--- /dev/null
+++ b/test_sum_sales.py
@@ -0,0 +1,17 @@
+import io
+import runpy
+from contextlib import redirect_stdout
+from pathlib import Path
+from unittest.mock import mock_open, patch
+
+script = Path(__file__).with_name("sum_sales.py")
+for contents, expected in [
+    ('customer,amount\n"Ada, Jr.",0.10\nGrace,0.20\nLinus,-0.05\n', "0.25"),
+    ("customer,amount\n", "0"),
+]:
+    output = io.StringIO()
+    with patch("builtins.open", mock_open(read_data=contents)), redirect_stdout(output):
+        runpy.run_path(str(script))
+    assert output.getvalue().strip() == expected, output.getvalue()
+
+print("Checks passed")
