-from fastapi import FastAPI
+from collections import OrderedDict
+from math import ceil
+from threading import Lock
+from time import monotonic
+
+from fastapi import Depends, FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+REQUEST_LIMIT = 60
+WINDOW_SECONDS = 60
+# braid(yagni): per-process counters; use shared storage for multiple workers.
+_clients = OrderedDict()
+_lock = Lock()
+
+
+def rate_limit(request: Request):
+    client = request.client.host if request.client else "unknown"
+    with _lock:
+        now = monotonic()
+        while _clients:
+            _, (expires, _) = next(iter(_clients.items()))
+            if expires > now:
+                break
+            _clients.popitem(last=False)
+        expires, count = _clients.get(client, (now + WINDOW_SECONDS, 0))
+        if count >= REQUEST_LIMIT:
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests",
+                headers={"Retry-After": str(ceil(expires - now))},
+            )
+        _clients[client] = (expires, count + 1)
+
 
 class Message(BaseModel):
     text: str
 
 
-@app.post("/messages")
+@app.post("/messages", dependencies=[Depends(rate_limit)])
 def create_message(message: Message):
     return {"ok": True, "length": len(message.text)}
