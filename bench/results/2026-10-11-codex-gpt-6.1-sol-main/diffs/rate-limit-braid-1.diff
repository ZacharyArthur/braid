+import unittest
+from unittest.mock import patch
+
+from fastapi.testclient import TestClient
+
+import main
+
+
+class RateLimitTest(unittest.TestCase):
+    def test_limit_clients_and_expiration(self):
+        main._clients.clear()
+        self.addCleanup(main._clients.clear)
+        with patch("main.monotonic", return_value=100) as clock:
+            with TestClient(main.app, client=("192.0.2.1", 1234)) as client:
+                for _ in range(main.REQUEST_LIMIT):
+                    response = client.post("/messages", json={"text": "hello"})
+                    self.assertEqual(response.status_code, 200)
+                    self.assertEqual(response.json(), {"ok": True, "length": 5})
+                response = client.post("/messages", json={"text": "hello"})
+                self.assertEqual(response.status_code, 429)
+                self.assertEqual(response.headers["Retry-After"], "60")
+                with TestClient(main.app, client=("192.0.2.2", 1234)) as other:
+                    self.assertEqual(other.post("/messages", json={"text": "hi"}).status_code, 200)
+                clock.return_value = 160
+                self.assertEqual(client.post("/messages", json={"text": "hi"}).status_code, 200)
+                self.assertEqual(len(main._clients), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
