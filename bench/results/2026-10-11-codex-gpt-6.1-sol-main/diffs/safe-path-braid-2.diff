+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from uploads import safe_upload_path
+
+
+class SafeUploadPathTests(unittest.TestCase):
+    def test_filename(self):
+        base = Path(__file__).parent.resolve()
+        self.assertEqual(safe_upload_path(base, "photo.png"), str(base / "photo.png"))
+
+    def test_unsafe_filenames(self):
+        for filename in (
+            "", ".", "..", "../secret", "..\\secret", "/secret",
+            "C:\\secret", "C:secret", "\\\\server\\share", "file:stream",
+            "folder/file", "file\0.png", None,
+        ):
+            with self.subTest(filename=filename), self.assertRaises(ValueError):
+                safe_upload_path("uploads", filename)
+
+    def test_symlink_escape(self):
+        base = Path(__file__).parent.resolve()
+        with patch.object(Path, "resolve", side_effect=[base, base.parent / "secret"]):
+            with self.assertRaises(ValueError):
+                safe_upload_path(base, "escape")
+
+
+if __name__ == "__main__":
+    unittest.main()
