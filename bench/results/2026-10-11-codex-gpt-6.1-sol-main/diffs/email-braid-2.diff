@@ -0,0 +1,33 @@
+import re
+
+
+def is_valid_email(address: str) -> bool:
+    """Validate common ASCII email syntax; this does not verify delivery."""
+    if not isinstance(address, str) or len(address) > 254:
+        return False
+    if address.count("@") != 1:
+        return False
+    local, domain = address.split("@")
+    if not 1 <= len(local) <= 64 or local.startswith(".") or local.endswith("."):
+        return False
+    if ".." in local or not re.fullmatch(r"[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+", local):
+        return False
+    labels = domain.split(".")
+    return len(labels) >= 2 and all(
+        re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", label)
+        is not None
+        for label in labels
+    )
+
+
+if __name__ == "__main__":
+    for address in ("alice@example.com", "a.b+tag@sub.example.org", "a@x.io"):
+        assert is_valid_email(address), address
+    for address in (
+        None, "", "a@@example.com", "a..b@example.com", ".a@example.com",
+        "a.@example.com", "a@example", "a@-example.com", "a@example..com",
+        "a@example.com\n", "a b@example.com", "a" * 65 + "@example.com",
+        "a@" + "b" * 64 + ".com",
+    ):
+        assert not is_valid_email(address), address
+    print("Email validation checks passed.")
