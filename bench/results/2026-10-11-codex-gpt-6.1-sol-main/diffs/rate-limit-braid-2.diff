+from fastapi import FastAPI, HTTPException, Request
 from pydantic import BaseModel
 
 app = FastAPI()
 
+RATE_LIMIT = 10
+RATE_WINDOW = 60
+_requests = {}
+_rate_lock = Lock()
+
+
+def check_rate_limit(request: Request):
+    client = request.client.host if request.client else "unknown"
+    # braid(yagni): per-process state; use a shared store for multiple workers.
+    with _rate_lock:
+        now = monotonic()
+        for key in list(_requests):
+            timestamps = _requests[key]
+            while timestamps and timestamps[0] <= now - RATE_WINDOW:
+                timestamps.popleft()
+            if not timestamps:
+                del _requests[key]
+
+        timestamps = _requests.setdefault(client, deque())
+        if len(timestamps) >= RATE_LIMIT:
+            retry_after = ceil(timestamps[0] + RATE_WINDOW - now)
+            raise HTTPException(
+                status_code=429,
+                detail="Too many requests",
+                headers={"Retry-After": str(retry_after)},
+            )
+        timestamps.append(now)
+
 
