diff --git a/debounce.js b/debounce.js
new file mode 100644
index 0000000..99b0b01
--- /dev/null
+++ b/debounce.js
@@ -0,0 +1,10 @@
+function debounce(fn, delay) {
+  let timer;
+
+  return function (...args) {
+    clearTimeout(timer);
+    timer = setTimeout(() => fn.apply(this, args), delay);
+  };
+}
+
+module.exports = debounce;
diff --git a/debounce.test.js b/debounce.test.js
new file mode 100644
index 0000000..7a0e455
--- /dev/null
+++ b/debounce.test.js
@@ -0,0 +1,22 @@
+const assert = require('node:assert/strict');
+const { mock } = require('node:test');
+const debounce = require('./debounce');
+
+mock.timers.enable({ apis: ['setTimeout'] });
+try {
+  const calls = [];
+  const receiver = { run: debounce(function (...args) { calls.push([this, args]); }, 50) };
+  receiver.run('first');
+  mock.timers.tick(30);
+  receiver.run('last', 2);
+  mock.timers.tick(49);
+  assert.equal(calls.length, 0);
+  mock.timers.tick(1);
+  assert.deepEqual(calls, [[receiver, ['last', 2]]]);
+  receiver.run('again');
+  mock.timers.tick(50);
+  assert.equal(calls.length, 2);
+  console.log('Debounce checks passed');
+} finally {
+  mock.timers.reset();
+}
